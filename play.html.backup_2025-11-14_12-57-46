                        </div>
                        <div style="font-size: 11px; color: #888; margin-bottom: 5px;">
                            Regen: +${variant.regenRate} every ${variant.regenTime}s
                        </div>
                        <div style="font-size: 11px; color: #888; margin-bottom: 8px;">
                            Extraction: ${variant.extractionTime}s per item
                        </div>
                        <button class="extract-btn" data-variant-index="${index}" style="width: 100%; padding: 6px; background: #000; color: #00ff00; border: 2px solid #00ff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase;" onmouseover="this.style.background='#00ff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#00ff00';">EXTRACT</button>
                    `;
                    
                    container.appendChild(variantCard);
                });
                
                // Add click handlers for extract buttons
                container.querySelectorAll('.extract-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const variantIndex = parseInt(e.target.dataset.variantIndex);
                        this.queueExtraction(nodeId, variantIndex);
                    });
                });
                
                // Update extraction queue display
                this.updateExtractionQueue();
                
                modal.style.display = 'block';
            }
            
            /**
             * Queue resource extraction
             */
            queueExtraction(nodeId, variantIndex) {
                const node = this.resourceNodes.get(nodeId);
                if (!node || !node.variants[variantIndex]) return;
                
                const variant = node.variants[variantIndex];
                
                // Check if variant has stock
                if (variant.currentStock <= 0) {
                    console.warn(`⚠️  ${variant.name} is depleted`);
                    return;
                }
                
                // Create extraction task
                const extractionId = `extract_${nodeId}_${variantIndex}_${Date.now()}`;
                const extraction = {
                    id: extractionId,
                    nodeId: nodeId,
                    variantIndex: variantIndex,
                    resourceName: variant.name,
                    startTime: Date.now(),
                    duration: variant.extractionTime * 1000, // Convert to milliseconds
                    completed: false
                };
                
                this.extractionQueue.push(extraction);
                
                // Start timer
                setTimeout(() => {
                    this.completeExtraction(extractionId);
                }, extraction.duration);
                
                console.log(`⏳ Queued extraction: ${variant.name} (${variant.extractionTime}s)`);
                this.updateExtractionQueue();
            }
            
            /**
             * Complete extraction and add to inventory
             */
            completeExtraction(extractionId) {
                const extraction = this.extractionQueue.find(e => e.id === extractionId);
                if (!extraction) return;
                
                const node = this.resourceNodes.get(extraction.nodeId);
                if (!node) return;
                
                const variant = node.variants[extraction.variantIndex];
                if (!variant || variant.currentStock <= 0) {
                    // Remove from queue if depleted
                    this.extractionQueue = this.extractionQueue.filter(e => e.id !== extractionId);
                    this.updateExtractionQueue();
                    return;
                }
                
                // Deduct stock
                variant.currentStock = Math.max(0, variant.currentStock - 1);
                
                // Add to inventory
                this.addToInventory(extraction.resourceName, 1);
                
                // Remove from queue
                this.extractionQueue = this.extractionQueue.filter(e => e.id !== extractionId);
                
                console.log(`✅ Extracted ${extraction.resourceName} - Added to inventory`);
                
                // Update UI if modal is open
                if (this.currentResourceNode && this.currentResourceNode.id === extraction.nodeId) {
                    this.openResourceNode(extraction.nodeId); // Refresh modal
                }
                this.updateExtractionQueue();
            }
            
            /**
             * Get item weight definition
             */
            getItemWeight(itemName) {
                const weights = {
                    // Resources (reduced weights for better balance)
                    'Oak': 0.3, 'Beech': 0.3, 'Pine': 0.4, 'Maple': 0.3, 'Cedar': 0.3,
                    'Iron Ore': 1.2, 'Rich Iron': 1.5, 'Crude Iron': 1.0,
                    'Gold Ore': 1.8, 'Pure Gold': 2.5, 'Gold Nuggets': 1.5,
                    'Coal': 0.8, 'Anthracite': 1.0,
                    'Stone': 1.5, 'Granite': 2.0, 'Limestone': 1.2,
                    'Crystal': 0.6, 'Pure Crystal': 1.0, 'Crystal Shards': 0.5,
                    'Herbs': 0.1, 'Rare Herbs': 0.2, 'Medicinal Herbs': 0.15,
                    'Water': 0.5, 'Spring Water': 0.5,
                    'Clay': 0.8, 'Rich Clay': 1.0,
                    'Crude Oil': 0.7, 'Refined Oil': 0.6,
                    // Tech resources (reduced)
                    'Basic Circuit': 0.2, 'Advanced Circuit': 0.3, 'Copper Wire': 0.1, 'Silicon Wafer': 0.25,
                    'Processor Chip': 0.15, 'Quantum Chip': 0.3, 'Memory Chip': 0.15,
                    'CPU': 0.6, 'High-Performance CPU': 1.0, 'GPU': 0.8,
                    // Crafted items (reduced)
                    'Computer': 2.0, 'Quantum Computer': 3.5,
                    'Refined Lumber': 0.6, 'Metal Pipes': 1.2, 'Water Filter': 1.0,
                    'Irrigation Pump': 2.5, 'Industrial Tool': 2.2,
                    'Crowd Drone': 1.5, 'Delivery Bot': 3.0
                };
                return weights[itemName] || 0.5; // Default weight (reduced)
            }
            
            /**
             * Calculate total weight of inventory
             */
            calculateInventoryWeight() {
                let totalWeight = 0;
                this.sharedInventory.forEach(slot => {
                    if (slot) {
                        const itemWeight = this.getItemWeight(slot.item);
                        totalWeight += itemWeight * slot.quantity;
                    }
                });
                return totalWeight;
            }
            
            /**
             * Update gear bonuses (recalculate capacity and slots)
             */
            updateGearBonuses() {
                let weightBonus = 0;
                let slotBonus = 0;
                let movementBonus = 0;
                let staminaBonus = 0;
                
                Object.values(this.gearSlots).forEach(gear => {
                    if (gear) {
                        weightBonus += gear.weightCapacity || 0;
                        slotBonus += gear.inventorySlots || 0;
                        movementBonus += gear.movementSpeed || 0;
                        staminaBonus += gear.staminaRecovery || 0;
                    }
                });
                
                this.maxWeightCapacity = this.baseWeightCapacity + weightBonus;
                this.maxInventorySlots = this.inventorySlots + slotBonus;
                
                // Update movement speed if needed
                if (movementBonus > 0) {
                    this.movementSpeed = 3 + (movementBonus * 0.1); // 10% per point
                }
            }
            
            /**
             * Add item to inventory (slot-based with weight)
             */
            addToInventory(itemName, quantity) {
                const originalQuantity = quantity;
                const itemWeight = this.getItemWeight(itemName);
                const currentWeight = this.calculateInventoryWeight();
                
                const isFragile = this.isFragileItem(itemName);
                
                // Check weight capacity
                const totalWeightNeeded = itemWeight * quantity;
                const availableWeight = this.maxWeightCapacity - currentWeight;
                
                if (totalWeightNeeded > availableWeight) {
                    // Can't fit all, calculate how many fit
                    const canFit = Math.floor(availableWeight / itemWeight);
                    if (canFit <= 0) {
                        console.warn(`⚠️  Inventory too heavy! Cannot add ${itemName}`);
                        return false;
                    }
                    quantity = canFit;
                    console.warn(`⚠️  Weight limit reached! Only adding ${quantity} of ${originalQuantity} ${itemName}`);
                }
                
                // Fragile items cannot be stacked - each must be in its own slot
                if (isFragile) {
                    // Find empty slots for fragile items (one per slot)
                    while (quantity > 0) {
                        const emptySlotIndex = this.sharedInventory.findIndex(slot => slot === null);
                        if (emptySlotIndex === -1) {
                            console.warn(`⚠️  Inventory full! Could not add ${quantity} fragile ${itemName}`);
                            break;
                        }
                        
                        // Each fragile item gets its own slot (quantity = 1)
                        this.sharedInventory[emptySlotIndex] = {
                            item: itemName,
                            quantity: 1
                        };
                        this.markItemAsFragile(emptySlotIndex, itemName);
                        quantity -= 1;
                    }
                } else {
                    // Non-fragile items can stack
                    // Find existing stack of this item
                    for (let i = 0; i < this.sharedInventory.length; i++) {
                        const slot = this.sharedInventory[i];
                        if (slot && slot.item === itemName && slot.quantity < 99) {
                            const canAdd = Math.min(quantity, 99 - slot.quantity);
                            slot.quantity += canAdd;
                    quantity -= canAdd;
                            if (quantity <= 0) break;
                        }
                }
                
                    // Find empty slots for remaining items
                while (quantity > 0) {
                        const emptySlotIndex = this.sharedInventory.findIndex(slot => slot === null);
                        if (emptySlotIndex === -1) {
                            console.warn(`⚠️  Inventory full! Could not add ${quantity} ${itemName}`);
                            break;
                        }
                        
                    const stackSize = Math.min(quantity, 99);
                        this.sharedInventory[emptySlotIndex] = {
                        item: itemName,
                        quantity: stackSize
                        };
                    quantity -= stackSize;
                    }
                }
                
                this.currentWeight = this.calculateInventoryWeight();
                this.updateInventoryUI();
                console.log(`📦 Inventory: Added ${originalQuantity - quantity} ${itemName} (Weight: ${this.currentWeight.toFixed(1)}/${this.maxWeightCapacity})`);
                return true;
            }
            
            /**
             * Remove item from inventory
             */
            removeFromInventory(itemName, quantity) {
                let remaining = quantity;
                
                for (let i = 0; i < this.sharedInventory.length; i++) {
                    const slot = this.sharedInventory[i];
                    if (slot && slot.item === itemName && remaining > 0) {
                        if (slot.quantity <= remaining) {
                            remaining -= slot.quantity;
                            this.sharedInventory[i] = null; // Empty slot
                        } else {
                            slot.quantity -= remaining;
                            remaining = 0;
                        }
                    }
                }
                
                this.currentWeight = this.calculateInventoryWeight();
                this.updateInventoryUI();
                return remaining === 0;
            }
            
            /**
             * Check if player has item in inventory (by name and quantity)
             */
            hasItemInInventory(itemName, quantity) {
                let total = 0;
                this.sharedInventory.forEach(slot => {
                    if (slot && slot.item === itemName) {
                        total += slot.quantity;
                    }
                });
                return total >= quantity;
            }
            
            /**
             * Get item count in inventory
             */
            getItemCount(itemName) {
                let total = 0;
                this.sharedInventory.forEach(slot => {
                    if (slot && slot.item === itemName) {
                        total += slot.quantity;
                    }
                });
                return total;
            }
            
