                        const progress = total > 0 ? (completed / total) * 100 : 0;
                        
                        // Get timer info
                        const timer = this.craftingTimers.get(queue.id);
                        let statusText = '';
                        let timeRemaining = '';
                        
                        if (timer) {
                            if (timer.isActive) {
                                const elapsed = Date.now() - timer.startTime;
                                const baseTime = timer.baseTime * 1000;
                                const speedMultiplier = 1 - (timer.speedUpPercent / 100);
                                const adjustedTime = baseTime * speedMultiplier;
                                const remainingMs = Math.max(0, adjustedTime - elapsed);
                                const remainingSec = Math.ceil(remainingMs / 1000);
                                timeRemaining = `TIME: ${remainingSec}s`;
                                statusText = '▶ CRAFTING...';
                            } else if (completed < total) {
                                statusText = '▶ QUEUED';
                            }
                        }
                        
                        if (completed >= total) {
                            statusText = '▶ COMPLETE';
                        }
                        
                        // Progress bar
                        const barWidth = 25;
                        const filled = Math.floor((progress / 100) * barWidth);
                        const empty = barWidth - filled;
                        const progressBar = '█'.repeat(filled) + '░'.repeat(empty);
                        
                        // Update only the text content, preserve buttons
                        const titleDiv = card.querySelector('div > div:first-child');
                        if (titleDiv) {
                            titleDiv.textContent = `▶ QUEUE #${index + 1}: ${recipe.name}`;
                        }
                        
                        const statusDiv = card.querySelector('div > div:nth-child(2)');
                        if (statusDiv) {
                            statusDiv.textContent = statusText;
                            statusDiv.style.color = completed >= total ? '#ffff00' : '#aaa';
                        }
                        
                        const timeDiv = card.querySelector('div > div:nth-child(3)');
                        if (timeRemaining) {
                            if (!timeDiv || !timeDiv.textContent.includes('TIME:')) {
                                const newTimeDiv = document.createElement('div');
                                newTimeDiv.style.cssText = 'font-size: 11px; color: #aaa; margin-top: 3px;';
                                newTimeDiv.textContent = timeRemaining;
                                statusDiv.parentNode.insertBefore(newTimeDiv, statusDiv.nextSibling);
                            } else if (timeDiv) {
                                timeDiv.textContent = timeRemaining;
                            }
                        } else if (timeDiv && timeDiv.textContent.includes('TIME:')) {
                            timeDiv.remove();
                        }
                        
                        const progressText = card.querySelector('div[style*="PROGRESS"]');
                        if (progressText) {
                            progressText.textContent = `PROGRESS: ${completed} / ${total} (${Math.round(progress)}%)`;
                        }
                        
                        const progressBarDiv = card.querySelector('div[style*="letter-spacing"]');
                        if (progressBarDiv) {
                            progressBarDiv.textContent = progressBar;
                        }
                        
                        // Check if we need to switch between withdraw button and speed-up/cancel buttons
                        const hasWithdrawBtn = card.querySelector('.withdraw-craft-btn');
                        const hasActionBtns = card.querySelector('.speed-up-craft-btn, .cancel-craft-btn');
                        const actionBtnsContainer = card.querySelector('div[style*="display: flex"]');
                        
                        // Debug: Log completion status
                        if (completed >= total) {
                            console.log(`✅ Queue ${queue.id} is COMPLETE (${completed}/${total}) - hasWithdrawBtn:`, !!hasWithdrawBtn);
                        }
                        
                        if (completed >= total && !hasWithdrawBtn) {
