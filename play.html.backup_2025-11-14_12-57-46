            /**
             * Update hover tooltip based on what player is hovering over
             */
            updateHoverTooltip(event) {
                const tooltip = document.getElementById('hover-tooltip');
                const tooltipText = document.getElementById('tooltip-text');
                if (!tooltip || !tooltipText) {
                    console.warn('⚠️  Tooltip elements not found');
                    return;
                }
                
                const tile = this.getTileAtMousePosition(event);
                if (!tile) {
                    tooltip.style.display = 'none';
                    return;
                }
                
                let text = '';
                let canInteract = false;
                
                // Check if player is close enough
                const isNear = this.isPlayerNearTile(tile);
                
                // Check for buildings/megacorps first (must check before resource check)
                let asset = null;
                
                // Method 1: Check if tile has assetId (set by raycasting)
                if (tile.assetId) {
                    asset = this.multiTileAssets.find(a => a.id === tile.assetId);
                    if (asset) {
                        console.log(`🔍 Found asset via assetId: ${asset.type} ${asset.name}`);
                    }
                }
                
                // Method 2: Check if tile is covered by any multi-tile asset
                if (!asset) {
                    // Try to find asset by assetId from tile (even if multiTileAssets is empty, we can reconstruct)
                    if (tile.assetId) {
                        // Parse asset info from assetId format: "building_delivery_depot_91_68"
                        const parts = tile.assetId.split('_');
                        if (parts.length >= 4) {
                            const assetType = parts[0]; // "building" or "megacorp"
                            const assetNameParts = parts.slice(1, -2); // ["delivery", "depot"] or ["alpha"]
                            const assetName = assetNameParts.join('_'); // "delivery_depot" or "alpha"
                            
                            // Create a temporary asset object for tooltip
                            asset = {
                                id: tile.assetId,
                                type: assetType,
                                name: assetName,
                                startCol: tile.col, // Approximate
                                startRow: tile.row,
                                width: 4, // Default
                                height: 4
                            };
                            console.log(`🔍 Reconstructed asset from tile.assetId: ${asset.type} ${asset.name}`);
                        }
                    }
                    
                    // Also check multiTileAssets if available
                    if (!asset && this.multiTileAssets && this.multiTileAssets.length > 0) {
                        for (const multiAsset of this.multiTileAssets) {
                            if (tile.col >= multiAsset.startCol && 
                                tile.col < multiAsset.startCol + multiAsset.width &&
                                tile.row >= multiAsset.startRow && 
                                tile.row < multiAsset.startRow + multiAsset.height) {
                                asset = multiAsset;
                                // Cache it on the tile for next time
                                tile.assetId = asset.id;
                                tile.assetType = asset.type;
                                tile.assetName = asset.name;
                                console.log(`🔍 Found asset via tile coverage: ${asset.type} ${asset.name} at tile (${tile.col}, ${tile.row})`);
                                break;
                            }
                        }
                    }
                }
                
                if (asset) {
                    console.log(`✅ Asset found: ${asset.type} ${asset.name} at tile (${tile.col}, ${tile.row})`);
                    if (asset.type === 'megacorp') {
                        const megacorpNames = {
                            'alpha': 'ALPHA',
                            'beta': 'BETA',
                            'gamma': 'GAMMA',
                            'delta': 'DELTA'
                        };
                        text = `🏢 MEGACORP ${megacorpNames[asset.name] || asset.name.toUpperCase()}`;
                        canInteract = isNear;
                        console.log(`🏢 Megacorp hover: ${text}`);
                    } else if (asset.type === 'building') {
