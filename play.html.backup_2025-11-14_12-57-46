            /**
             * Open resource node modal for extraction
             */
            openResourceNode(nodeId) {
                const node = this.resourceNodes.get(nodeId);
                if (!node) {
                    console.warn(`⚠️  Resource node ${nodeId} not found`);
                    return;
                }
                
                this.currentResourceNode = node;
                const modal = document.getElementById('resource-modal');
                const container = document.getElementById('resource-variants-container');
                if (!modal || !container) return;
                
                // Display resource type
                container.innerHTML = `<div style="font-size: 14px; color: #ffff00; margin-bottom: 15px; text-align: center;">${node.type.toUpperCase()} RESOURCE NODE</div>`;
                
