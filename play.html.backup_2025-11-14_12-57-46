                if (!queueList) return;
                
                if (this.extractionQueue.length === 0) {
                    queueList.innerHTML = '<div style="color: #888; font-size: 11px;">No extractions in queue</div>';
                    return;
                }
                
                queueList.innerHTML = this.extractionQueue.map(extraction => {
