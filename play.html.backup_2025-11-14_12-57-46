                node.variants.forEach((variant, index) => {
                    const variantCard = document.createElement('div');
                    variantCard.style.cssText = 'background: rgba(0, 0, 0, 0.6); border: 2px solid #00ff00; padding: 10px; margin-bottom: 10px; border-radius: 4px; cursor: pointer; transition: all 0.1s;';
                    variantCard.onmouseover = () => variantCard.style.borderColor = '#ffff00';
                    variantCard.onmouseout = () => variantCard.style.borderColor = '#00ff00';
                    
                    const rarityColor = variant.rarity === 'rare' ? '#ffff00' : '#00ff00';
                    const rarityText = variant.rarity === 'rare' ? '⭐ RARE' : '';
                    
                    variantCard.innerHTML = `
