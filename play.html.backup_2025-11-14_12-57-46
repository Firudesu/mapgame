            /**
             * Render roads as visible meshes using the road asset
             */
            renderRoads() {
                const loader = new THREE.TextureLoader();
                const roadGroup = new THREE.Group();
                const tileSize = 16;
                
                // Count active road tiles
                const roadTiles = this.tiles.filter(t => t.type === 'road' && t.active);
                const totalRoads = roadTiles.length;
                
                console.log(`🛣️  Rendering ${totalRoads} road tiles...`);
                
                if (totalRoads === 0) {
                    console.warn('⚠️  No road tiles found to render!');
                    return;
                }
                
                // Try multiple paths for road texture (same as resources)
                const roadAssetPaths = [
                    './public/assets/tile_road.png',
                    '/public/assets/tile_road.png',
                    'public/assets/tile_road.png'
                ];
                
                // Load texture once, then create all sprites
                let textureLoaded = false;
                let sharedTexture = null;
                
                const createRoadSprites = (texture) => {
                    roadTiles.forEach(tile => {
                        const spriteMaterial = new THREE.SpriteMaterial({
                            map: texture || null,
                            color: texture ? 0xffffff : 0x333333, // Use texture color or dark gray fallback
                            transparent: true,
                            opacity: 1.0
                        });
                        
                        const sprite = new THREE.Sprite(spriteMaterial);
                        // Perfect fit: scale exactly to tile size (16x16)
                        sprite.scale.set(tileSize, tileSize, 1);
                        // Position at exact tile center for seamless connection
                        sprite.position.set(tile.x, tile.y, 0.3); // Above map, below resources/buildings
                        sprite.center.set(0.5, 0.5); // Center the sprite texture
                        
                        roadGroup.add(sprite);
                    });
                    
                    this.scene.add(roadGroup);
                    this.roadGroup = roadGroup;
                    console.log(`✅ Rendered ${totalRoads} road tiles ${texture ? 'with texture' : 'with fallback color'}`);
                };
                
                // Try to load texture from multiple paths
                const tryLoadTexture = (pathIndex) => {
                    if (pathIndex >= roadAssetPaths.length) {
                        // All paths failed, use fallback
                        if (!textureLoaded) {
                            console.log(`⚠️  Road texture not found, using fallback color for all roads`);
                            createRoadSprites(null);
                        }
                        return;
                    }
                    
                    const roadAssetPath = roadAssetPaths[pathIndex];
                    loader.load(
                        roadAssetPath,
                        (texture) => {
                            if (textureLoaded) return; // Already loaded
                            textureLoaded = true;
                            sharedTexture = texture;
                            console.log(`✅ Road texture loaded from: ${roadAssetPath}`);
                            createRoadSprites(texture);
                        },
                        undefined,
                        (error) => {
                            // Try next path
                            tryLoadTexture(pathIndex + 1);
                        }
                    );
                };
                
                tryLoadTexture(0);
            }
            
            /**
             * Render multi-tile assets (buildings, megacorps) on the map
             */
            renderMultiTileAssets() {
                if (!this.multiTileAssets || this.multiTileAssets.length === 0) {
                    console.warn('⚠️  No multi-tile assets to render');
                    return;
                }
                
                console.log(`🎨 Rendering ${this.multiTileAssets.length} multi-tile assets...`);
                
                const loader = new THREE.TextureLoader();
                const assetGroup = new THREE.Group();
                
                this.multiTileAssets.forEach((asset, index) => {
                    console.log(`📦 Asset ${index + 1}/${this.multiTileAssets.length}: ${asset.type} ${asset.name} at (${asset.startCol}, ${asset.startRow})`);
                    
                    // Determine asset path (try multiple paths)
                    let assetPath = '';
                    if (asset.type === 'megacorp') {
                        assetPath = `/public/assets/megacorp_${asset.name}.png`;
                    } else if (asset.type === 'building') {
                        // Map building names to asset files
                        const buildingMap = {
                            'delivery_depot': 'building_delivery_depot_4x4',
                            'crafting_place': 'building_crafting_place_4x4',
                            'market': 'building_market_5x5'
                        };
                        const fileName = buildingMap[asset.name] || `building_${asset.name}`;
                        assetPath = `/public/assets/${fileName}.png`;
                    }
                    
                    if (!assetPath) {
                        console.warn(`⚠️  No asset path for ${asset.type} ${asset.name}`);
                        return;
                    }
                    
                    console.log(`   → Loading: ${assetPath}`);
                    
                    // Load texture and create plane mesh (better for orthographic camera)
                    loader.load(
                        assetPath,
                        (texture) => {
                            // Calculate world position (center of asset)
                            const halfWidth = 1024;
                            const halfHeight = 926;
                            const tileSize = 16;
                            
                            const centerCol = asset.startCol + (asset.width / 2);
                            const centerRow = asset.startRow + (asset.height / 2);
                            const worldX = -halfWidth + (centerCol * tileSize);
                            const worldY = halfHeight - (centerRow * tileSize);
                            
                            // Calculate world size
                            const worldWidth = asset.width * tileSize;
                            const worldHeight = asset.height * tileSize;
                            
                            // Create main asset plane geometry
                            const geometry = new THREE.PlaneGeometry(worldWidth, worldHeight);
                            
                            // Create material with texture - ensure transparency is handled
                            // Flip texture Y to correct orientation (Three.js textures are flipped by default)
                            texture.flipY = true; // Flip texture to correct upside-down issue
                            const material = new THREE.MeshBasicMaterial({
                                map: texture,
                                transparent: true,
                                opacity: 1.0,
                                alphaTest: 0.1, // Discard pixels with alpha < 0.1 (removes black backgrounds)
                                side: THREE.DoubleSide // Double-sided like map
                            });
                            
                            // Create mesh - match map plane orientation exactly (no rotation, same as map)
                            const mesh = new THREE.Mesh(geometry, material);
                            // Map is at z=0, assets should be slightly above at z>0
                            // Position in world coordinates (map center is 0,0, map goes from -1024 to +1024 in X, -926 to +926 in Y)
                            mesh.position.set(worldX, worldY, 1.0); // Z=1.0 to be above map
            
                            // Optional: Add subtle square border (can be removed if not needed)
                            // Note: This creates a square border. For shape-following borders, we'd need
                            // edge detection on the alpha channel, which is more complex.
                            const showBorder = false; // Set to true to enable square border
                            if (showBorder) {
                                const borderThickness = 1;
                                const borderGeometry = new THREE.PlaneGeometry(
                                    worldWidth + (borderThickness * 2),
                                    worldHeight + (borderThickness * 2)
                                );
                                const borderMaterial = new THREE.MeshBasicMaterial({
                                    color: 0x000000,
                                    transparent: true,
                                    opacity: 0.2, // Very subtle
                                    side: THREE.DoubleSide
                                });
                                const borderMesh = new THREE.Mesh(borderGeometry, borderMaterial);
                                borderMesh.position.set(worldX, worldY, 0.95); // Just below main asset
                                assetGroup.add(borderMesh);
                            }
                            
                            // Add asset to scene
                            assetGroup.add(mesh);
                            
                            console.log(`✅ Rendered ${asset.type} ${asset.name} at (${worldX}, ${worldY}) - ${worldWidth}×${worldHeight}`);
                            
                            asset.mesh = mesh; // Store reference
                        },
                        undefined,
                        (error) => {
                            console.error(`❌ Could not load asset texture: ${assetPath}`, error);
                            console.error(`   Asset details:`, asset);
                            // Try alternative paths
                            const altPaths = [
                                `./public/assets/${assetPath.split('/').pop()}`,
                                `./${assetPath.split('/').pop()}`,
                                assetPath.replace('/public/', 'public/')
                            ];
                            console.warn(`   Trying alternative paths:`, altPaths);
                        }
                    );
                });
                
                this.scene.add(assetGroup);
                this.assetGroup = assetGroup; // Store reference
                
                console.log(`✅ Asset group added to scene with ${assetGroup.children.length} children (will grow as textures load)`);
                console.log(`   Total assets to load: ${this.multiTileAssets.length}`);
                console.log(`   Megacorps: ${this.multiTileAssets.filter(a => a.type === 'megacorp').length}`);
                console.log(`   Buildings: ${this.multiTileAssets.filter(a => a.type === 'building').length}`);
            }
            
