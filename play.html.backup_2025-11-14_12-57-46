                this.nextResourceRotation = this.lastResourceRotation + this.resourceRotationInterval; // Next rotation time
                
                // Road upkeep system
                this.roadUpkeepPayments = new Map(); // Track GDP payments per region (timestamp)
                this.roadDegradationRate = 100 / (3 * 24 * 60 * 60 * 1000); // 100% over 3 days in ms
