            /**
             * Create visual overlays and borders for regions
             */
            createRegionVisualizations() {
                const halfWidth = 1024;
                const halfHeight = 926;
                const tileSize = 16;
                
                this.regions.forEach(region => {
                    // Calculate world coordinates
                    const startX = -halfWidth + (region.colStart * tileSize);
                    const endX = -halfWidth + (region.colEnd * tileSize);
                    const startY = halfHeight - (region.rowEnd * tileSize);
                    const endY = halfHeight - (region.rowStart * tileSize);
                    
                    const width = endX - startX;
                    const height = endY - startY;
                    const centerX = startX + (width / 2);
                    const centerY = startY + (height / 2);
                    
                    // Create color overlay (fades with zoom)
                    const overlayGeometry = new THREE.PlaneGeometry(width, height);
                    const overlayMaterial = new THREE.MeshBasicMaterial({
                        color: region.color,
                        transparent: true,
                        opacity: 0.15, // Base opacity, will fade with zoom
                        side: THREE.DoubleSide
                    });
                    const overlay = new THREE.Mesh(overlayGeometry, overlayMaterial);
                    overlay.position.set(centerX, centerY, 0.05); // Just above ground
                    overlay.userData.region = region;
                    overlay.userData.baseOpacity = 0.15;
                    this.regionOverlays.push(overlay);
                    this.scene.add(overlay);
                    
                    // Create border outline (always visible)
                    const borderGroup = new THREE.Group();
                    const borderMaterial = new THREE.LineBasicMaterial({
                        color: region.color,
                        linewidth: 2,
                        transparent: true,
                        opacity: 0.8
                    });
                    
                    // Top border
                    const topGeometry = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(startX, endY, 0.1),
                        new THREE.Vector3(endX, endY, 0.1)
                    ]);
                    const topLine = new THREE.Line(topGeometry, borderMaterial);
                    borderGroup.add(topLine);
                    
                    // Bottom border
                    const bottomGeometry = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(startX, startY, 0.1),
                        new THREE.Vector3(endX, startY, 0.1)
                    ]);
                    const bottomLine = new THREE.Line(bottomGeometry, borderMaterial);
                    borderGroup.add(bottomLine);
                    
                    // Left border
                    const leftGeometry = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(startX, startY, 0.1),
                        new THREE.Vector3(startX, endY, 0.1)
                    ]);
                    const leftLine = new THREE.Line(leftGeometry, borderMaterial);
                    borderGroup.add(leftLine);
                    
                    // Right border
                    const rightGeometry = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(endX, startY, 0.1),
                        new THREE.Vector3(endX, endY, 0.1)
                    ]);
                    const rightLine = new THREE.Line(rightGeometry, borderMaterial);
                    borderGroup.add(rightLine);
                    
                    this.regionBorders.push(borderGroup);
                    this.scene.add(borderGroup);
                    
                    // Create region name label (HTML overlay)
                    const label = document.createElement('div');
                    label.textContent = region.name;
                    label.style.position = 'absolute';
                    label.style.color = region.colorHex;
                    label.style.fontFamily = "'Press Start 2P', monospace";
