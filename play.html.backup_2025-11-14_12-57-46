                // Crafting System
                this.craftingQueues = new Map(); // stationId -> array of crafting queues (max 3)
                this.craftingTimers = new Map(); // queueId -> timer data
                this.maxCraftingSlots = 3; // Base slots
                this.maxItemsPerQueue = 99; // Max items per recipe queue
                this.currentCraftingStation = null; // Currently open station
                this.craftingUIUpdateInterval = null; // Interval for updating crafting UI
                this.currentSpeedUpQueue = null; // Currently open speed-up queue

                this.init();
