            /**
             * Update region overlay opacity and label visibility based on zoom
             */
            updateRegionVisualizations() {
                // Fade overlays when zoomed in (zoom > 1.5 = more faded)
                // More visible when zoomed out (zoom < 1.0 = more visible)
                // Overlay fades from 0.25 at zoom 0.5 to 0.0 at zoom 3.0
                const minZoom = 0.5;
                const maxZoom = 3.0;
                const zoomRange = maxZoom - minZoom;
                const normalizedZoom = Math.max(minZoom, Math.min(maxZoom, this.zoomLevel));
                const zoomFactor = 1.0 - ((normalizedZoom - minZoom) / zoomRange); // 1.0 at minZoom, 0.0 at maxZoom
                
                const overlayOpacity = Math.max(0, Math.min(0.25, zoomFactor * 0.25));
                const labelOpacity = Math.max(0, Math.min(1.0, zoomFactor));
                
                this.regionOverlays.forEach(overlay => {
                    overlay.material.opacity = overlayOpacity;
                });
                
                this.regionLabels.forEach(label => {
                    label.style.opacity = labelOpacity;
                    
                    // Update label position based on camera
                    const region = this.regionLabelMap ? this.regionLabelMap.get(label) : null;
                    if (region) {
                        const halfWidth = 1024;
                        const halfHeight = 926;
                        const tileSize = 16;
                        
                        const centerCol = (region.colStart + region.colEnd) / 2;
                        const centerRow = (region.rowStart + region.rowEnd) / 2;
                        const worldX = -halfWidth + (centerCol * tileSize);
                        const worldY = halfHeight - (centerRow * tileSize);
                        
                        // Convert world position to screen position
                        const vector = new THREE.Vector3(worldX, worldY, 0);
                        vector.project(this.camera);
                        
                        const x = (vector.x * 0.5 + 0.5) * window.innerWidth;
                        const y = (-vector.y * 0.5 + 0.5) * window.innerHeight;
                        
                        label.style.left = x + 'px';
                        label.style.top = y + 'px';
                        label.style.transform = 'translate(-50%, -50%)';
                    }
                });
                
                // Borders always stay visible (opacity set in createRegionVisualizations)
            }
            
            /**
             * Place a megacorp building (4×8 tiles)
             */
            placeMegacorp(region) {
                const centerCol = Math.floor((region.colStart + region.colEnd) / 2);
                const centerRow = Math.floor((region.rowStart + region.rowEnd) / 2);
                
                // Try center position first
                let startCol = Math.max(region.colStart + 2, centerCol - 2);
                let startRow = Math.max(region.rowStart + 4, centerRow - 4);
                
                console.log(`   🏢 Attempting to place megacorp ${region.corp} at center (${startCol}, ${startRow})...`);
                
                if (this.canPlaceAsset(startCol, startRow, 4, 8, region)) {
                    this.placeMultiTileAsset('megacorp', region.corp, startCol, startRow, 4, 8, region);
                    console.log(`   ✅ Megacorp ${region.corp} placed successfully!`);
                    return;
                }
                
                // If center doesn't work, try nearby positions
                console.warn(`   ⚠️  Could not place megacorp at center (${startCol}, ${startRow}), trying alternatives...`);
                
                let attempts = 0;
                const maxAttempts = 100; // More attempts
                while (attempts < maxAttempts) {
                    // Try random position in region (with proper bounds checking)
                    const maxCol = Math.max(region.colStart + 2, region.colEnd - 6);
                    const maxRow = Math.max(region.rowStart + 4, region.rowEnd - 12);
                    startCol = region.colStart + 2 + Math.floor(Math.random() * Math.max(1, maxCol - region.colStart - 2));
                    startRow = region.rowStart + 4 + Math.floor(Math.random() * Math.max(1, maxRow - region.rowStart - 4));
                    
                    if (this.canPlaceAsset(startCol, startRow, 4, 8, region)) {
                        console.log(`   ✅ Found alternative position: (${startCol}, ${startRow})`);
                        this.placeMultiTileAsset('megacorp', region.corp, startCol, startRow, 4, 8, region);
                        return;
                    }
                    attempts++;
                    if (attempts % 20 === 0) {
                        console.log(`   ⏳ Still searching... (${attempts}/${maxAttempts} attempts)`);
                    }
                }
                
                console.error(`   ❌ Could not place megacorp ${region.corp} in ${region.name} after ${maxAttempts} attempts`);
                console.error(`   📊 Region bounds: col ${region.colStart}-${region.colEnd}, row ${region.rowStart}-${region.rowEnd}`);
            }
            
            /**
             * Place a building (delivery depot, crafting, market)
             */
            placeBuilding(region, buildingType, width, height) {
                let attempts = 0;
                const maxAttempts = 100;
                
                while (attempts < maxAttempts) {
                    // Try random position in region
                    const maxCol = Math.max(region.colStart + 1, region.colEnd - width - 1);
                    const maxRow = Math.max(region.rowStart + 1, region.rowEnd - height - 1);
                    const startCol = region.colStart + 1 + Math.floor(Math.random() * Math.max(1, maxCol - region.colStart - 1));
                    const startRow = region.rowStart + 1 + Math.floor(Math.random() * Math.max(1, maxRow - region.rowStart - 1));
                    
                    if (this.canPlaceAsset(startCol, startRow, width, height, region)) {
                        this.placeMultiTileAsset('building', buildingType, startCol, startRow, width, height, region);
                        console.log(`   ✅ Placed ${buildingType} at (${startCol}, ${startRow})`);
                        return;
                    }
                    attempts++;
                }
                
                console.warn(`   ⚠️  Could not place ${buildingType} in ${region.name} after ${maxAttempts} attempts`);
            }
            
