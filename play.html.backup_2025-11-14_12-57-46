            setupWebSocket() {
                try {
                    this.wsConnection = new WebSocket('ws://localhost:8080');
                    this.wsConnection.onopen = () => {
                        console.log('Connected to WebSocket');
                        this.updateConnectionStatus(true);
                        this.wsConnection.send(JSON.stringify({ type: 'getPlayers' }));
                    };
                    this.wsConnection.onmessage = (event) => {
                        const msg = JSON.parse(event.data);
                        if (msg.type === 'players') {
                            Object.values(msg.data).forEach(p => this.addPlayer(p));
                        } else if (msg.type === 'playerJoined') {
                            this.addPlayer(msg.data);
                        } else if (msg.type === 'playerLeft') {
                            this.removePlayer(msg.data.walletID);
                        } else if (msg.type === 'playerUpdated') {
                            // Update player position from network
                            const player = this.players.get(msg.data.walletID);
                            if (player && player.userData.walletID !== this.currentWallet) {
                                // Only update other players, not own player (own player updates itself)
                                const targetX = msg.data.x;
                                const targetY = msg.data.y;
                                
                                // If player is not already moving, start movement
                                if (!this.movingPlayers.has(msg.data.walletID)) {
                                    this.setMovementTarget(msg.data.walletID, {
                                        x: targetX,
                                        y: targetY,
                                        type: 'walkable'
                                    });
                                }
                                
                                // Update stamina
                                if (msg.data.stamina !== undefined) {
                                    player.userData.stamina = msg.data.stamina;
                                }
                            }
                        }
                    };
                    this.wsConnection.onerror = () => {
                        console.log('WebSocket not available - running local-only');
                        this.updateConnectionStatus(false);
                    };
                    this.wsConnection.onclose = () => {
                        this.updateConnectionStatus(false);
                    };
                } catch (e) {
                    console.log('WebSocket not available - running local-only');
                    this.updateConnectionStatus(false);
                }
            }

