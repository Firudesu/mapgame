            /**
             * Rotate resource variants every 12 hours
             */
            rotateResourceVariants() {
                console.log('🔄 Rotating resource variants...');
                const allVariants = this.getAllResourceVariants();
                
                this.resourceNodes.forEach((node, nodeId) => {
                    const resourceDef = allVariants[node.type];
                    if (!resourceDef) return;
                    
                    // Filter variants by spawn chance
                    const availableVariants = resourceDef.variants.filter(v => 
                        !v.spawnChance || Math.random() < v.spawnChance
                    );
                    
                    if (availableVariants.length > 0) {
                        // Select ONLY ONE variant per node (weighted by rarity)
                        const selectedVariant = this.selectSingleVariant(availableVariants);
                        
                        // Update node with single variant (reset stock to full)
                        node.variants = [{
                            ...selectedVariant,
                            currentStock: selectedVariant.maxStock // Reset to full stock
                        }];
                        
                        console.log(`   ✅ ${nodeId}: Now has ${selectedVariant.name}`);
                    }
                });
                
                // Update rotation timers
                this.lastResourceRotation = Date.now();
                this.nextResourceRotation = this.lastResourceRotation + this.resourceRotationInterval;
                
                // Refresh modal if open
                if (this.currentResourceNode) {
                    this.openResourceNode(this.currentResourceNode.id);
                }
            }
            
