            /**
             * Update road degradation based on upkeep payments
             */
            updateRoadDegradation() {
                const now = Date.now();
                // Calculate deltaTime from last update (managed by animation loop throttling)
                const lastUpdate = this.lastRoadUpdate || now;
                const deltaTime = Math.max(100, now - lastUpdate); // Minimum 100ms to prevent huge jumps
                
                // Update all road tiles
                this.tiles.forEach(tile => {
                    if (tile.type === 'road' && tile.active && tile.roadCondition !== undefined) {
                        const regionName = tile.roadRegion;
                        if (!regionName) return;
                        
                        // Check if region has recent upkeep payment (within last 3 days)
                        const lastPayment = this.roadUpkeepPayments.get(regionName) || 0;
                        const timeSincePayment = now - lastPayment;
                        const threeDays = 3 * 24 * 60 * 60 * 1000;
                        
                        // If no payment in last 3 days, degrade roads
                        if (timeSincePayment > threeDays) {
                            // Degrade based on time since last payment
                            const degradation = this.roadDegradationRate * deltaTime;
                            tile.roadCondition = Math.max(0, tile.roadCondition - degradation);
                        } else {
                            // Roads are maintained, restore to 100% if below
                            if (tile.roadCondition < 100) {
                                const restoreRate = 100 / (24 * 60 * 60 * 1000); // Restore 100% over 1 day
                                tile.roadCondition = Math.min(100, tile.roadCondition + (restoreRate * deltaTime));
                            }
                        }
                    }
                });
            }
            
            /**
             * Pay GDP for road upkeep in a region
             */
            payRoadUpkeep(regionName, amount) {
                if (this.sandBalance < amount) {
                    console.warn(`⚠️  Insufficient SAND for road upkeep. Need ${amount}, have ${this.sandBalance}`);
                    return false;
                }
                
                this.sandBalance -= amount;
                this.roadUpkeepPayments.set(regionName, Date.now());
                this.updateEconomyDisplay();
                
                console.log(`✅ Paid ${amount} SAND for road upkeep in ${regionName}`);
                return true;
            }
            
            /**
             * Connect buildings with roads following the grid
             */
            connectBuildingsWithRoads(region) {
                // Get all buildings in this region
                const regionBuildings = this.multiTileAssets.filter(asset => 
                    asset.region === region.name && asset.type === 'building'
                );
                
                // Also include megacorp
                const megacorp = this.multiTileAssets.find(asset => 
                    asset.region === region.name && asset.type === 'megacorp'
                );
                
                const allBuildings = megacorp ? [...regionBuildings, megacorp] : regionBuildings;
                
                if (allBuildings.length < 2) return; // Need at least 2 buildings to connect
                
                // Connect each building to the next one
                for (let i = 0; i < allBuildings.length - 1; i++) {
                    const building1 = allBuildings[i];
                    const building2 = allBuildings[i + 1];
                    
                    // Get center positions
                    const center1Col = building1.startCol + Math.floor(building1.width / 2);
                    const center1Row = building1.startRow + Math.floor(building1.height / 2);
                    const center2Col = building2.startCol + Math.floor(building2.width / 2);
                    const center2Row = building2.startRow + Math.floor(building2.height / 2);
                    
                    // Create road path (L-shaped or straight)
                    this.createRoadPath(center1Col, center1Row, center2Col, center2Row);
                }
            }
            
            /**
             * Create a road path between two points (L-shaped following grid)
             */
            createRoadPath(startCol, startRow, endCol, endRow) {
                // L-shaped path: first horizontal, then vertical
                const currentCol = startCol;
                const currentRow = startRow;
                
                // Move horizontally first
                const colStep = endCol > startCol ? 1 : -1;
                for (let col = startCol; col !== endCol; col += colStep) {
                    const tile = this.getTile(col, currentRow);
                    if (tile && tile.type !== 'blocked' && !tile.assetId) {
                        tile.type = 'road';
                        tile.active = true;
                        tile.roadCondition = 100; // Start at 100% condition
                        tile.roadRegion = this.getRegionForTile(col, currentRow)?.name || null;
                    }
                }
                
                // Then move vertically
                const rowStep = endRow > startRow ? 1 : -1;
                for (let row = currentRow; row !== endRow; row += rowStep) {
                    const tile = this.getTile(endCol, row);
                    if (tile && tile.type !== 'blocked' && !tile.assetId) {
                        tile.type = 'road';
                        tile.active = true;
                        tile.roadCondition = 100; // Start at 100% condition
                        tile.roadRegion = this.getRegionForTile(endCol, row)?.name || null;
                    }
                }
                
                // Mark destination tile as road too
                const endTile = this.getTile(endCol, endRow);
                if (endTile && endTile.type !== 'blocked' && !endTile.assetId) {
                    endTile.type = 'road';
                    endTile.active = true;
                    endTile.roadCondition = 100; // Start at 100% condition
                    endTile.roadRegion = this.getRegionForTile(endCol, endRow)?.name || null;
                }
            }
            
            /**
             * Check if an asset can be placed at location
             */
            canPlaceAsset(startCol, startRow, width, height, region) {
                // Check bounds
                if (startCol < region.colStart || startCol + width > region.colEnd ||
                    startRow < region.rowStart || startRow + height > region.rowEnd) {
                    return false;
                }
                
                // Check if all tiles are available
                for (let r = startRow; r < startRow + height; r++) {
                    for (let c = startCol; c < startCol + width; c++) {
                        const tile = this.getTile(c, r);
                        if (!tile) {
                            return false; // Tile doesn't exist
                        }
                        // Only block if tile is truly blocked (no image) or has another asset
                        if (tile.type === 'blocked' && tile.subType === 'no-image') {
                            return false; // Tile has no image content
                        }
                        if (tile.assetId) {
                            return false; // Tile already has an asset
                        }
                        // Allow placing on other tile types (blank, resource, etc.) - we'll override them
                    }
                }
                
                return true;
            }
            
            /**
             * Place a multi-tile asset and link all tiles
             */
            placeMultiTileAsset(assetType, assetName, startCol, startRow, width, height, region) {
                const assetId = `${assetType}_${assetName}_${startCol}_${startRow}`;
                const assetTiles = [];
                
                // Determine the tile type based on asset type
                let tileType = 'building';
                if (assetType === 'megacorp') {
                    tileType = 'megacorp';
                } else if (assetType === 'building') {
                    tileType = 'building';
                }
                
                // Mark all tiles as part of this asset (override existing tile types)
                for (let r = startRow; r < startRow + height; r++) {
                    for (let c = startCol; c < startCol + width; c++) {
                        const tile = this.getTile(c, r);
                        if (tile) {
                            // Only skip if tile has no image content
                            if (tile.type === 'blocked' && tile.subType === 'no-image') {
                                console.warn(`   ⚠️  Skipping tile (${c}, ${r}) - no image content`);
                                continue;
                            }
                            
                            // Override tile type to building/megacorp
                            tile.type = tileType;
                            tile.assetId = assetId;
                            tile.assetType = assetType;
                            tile.assetName = assetName;
                            tile.assetRegion = region.name;
                            // Clear other properties that don't make sense for buildings
                            tile.subType = null;
                            tile.active = false;
                            assetTiles.push(tile);
                        }
                    }
                }
                
                // Store asset info
                this.multiTileAssets.push({
                    id: assetId,
                    type: assetType,
                    name: assetName,
                    region: region.name,
                    startCol: startCol,
                    startRow: startRow,
                    width: width,
                    height: height,
                    tiles: assetTiles
                });
                
                console.log(`   ✅ Placed ${assetType} ${assetName} at (${startCol}, ${startRow}) - ${width}×${height} tiles`);
            }
            
