            /**
             * Select a single variant from available variants (weighted by rarity)
             * Rare variants appear less frequently
             */
            selectSingleVariant(availableVariants) {
                // Weight common variants more heavily
                const weightedVariants = [];
                availableVariants.forEach(variant => {
                    const weight = variant.rarity === 'rare' ? 1 : 3; // Common 3x more likely
                    for (let i = 0; i < weight; i++) {
                        weightedVariants.push(variant);
                    }
                });
                
                // Randomly select from weighted array
                return weightedVariants[Math.floor(Math.random() * weightedVariants.length)];
            }
            
            /**
             * Ensure at least one of each resource type is available somewhere on the map
             */
            ensureResourceCoverage() {
                const allResourceTypes = ['wood', 'iron_ore', 'gold_ore', 'crystal', 'coal', 'stone', 'herbs', 'water', 'clay', 'oil', 'circuit', 'chip', 'processor'];
                const resourceDefinitions = this.getAllResourceVariants();
                
                // Check which resource types are already present
                const presentTypes = new Set();
                this.resourceNodes.forEach((node) => {
                    presentTypes.add(node.type);
                });
                
                // Find missing resource types
                const missingTypes = allResourceTypes.filter(type => !presentTypes.has(type));
                
                if (missingTypes.length === 0) {
                    console.log('✅ All resource types are present on the map');
                    return;
                }
                
                console.log(`⚠️  Missing resource types: ${missingTypes.join(', ')}. Adding them...`);
                
                // Place missing resource types in random regions
                missingTypes.forEach(resourceType => {
                    const resourceDef = resourceDefinitions[resourceType];
                    if (!resourceDef) return;
                    
                    // Find a random region that can have this resource type
                    const suitableRegions = this.regions.filter(region => {
                        // Check if region already has this resource type or if it's a tech resource
                        if (resourceType === 'circuit' || resourceType === 'chip' || resourceType === 'processor') {
                            return region.techResources && region.techResources.includes(resourceType);
                        } else {
                            return region.resources && region.resources.includes(resourceType);
                        }
                    });
                    
                    // If no suitable region, use any region
                    const targetRegion = suitableRegions.length > 0 
                        ? suitableRegions[Math.floor(Math.random() * suitableRegions.length)]
                        : this.regions[Math.floor(Math.random() * this.regions.length)];
                    
                    // Find an empty tile in this region
                    let placed = false;
                    let attempts = 0;
                    while (!placed && attempts < 100) {
                        const col = targetRegion.colStart + Math.floor(Math.random() * (targetRegion.colEnd - targetRegion.colStart));
                        const row = targetRegion.rowStart + Math.floor(Math.random() * (targetRegion.rowEnd - targetRegion.rowStart));
                        
                        const tile = this.getTile(col, row);
                        if (tile && tile.type !== 'blocked' && !tile.assetId && !tile.resourceNodeId) {
                            // Filter variants by spawn chance
                            const availableVariants = resourceDef.variants.filter(v => 
                                !v.spawnChance || Math.random() < v.spawnChance
                            );
                            
                            if (availableVariants.length > 0) {
                                // Select ONE variant
                                const selectedVariant = this.selectSingleVariant(availableVariants);
                                
                                const nodeId = `resource_${col}_${row}_coverage`;
                                tile.type = 'resource';
                                tile.subType = resourceType;
                                tile.resourceNodeId = nodeId;
                                tile.region = targetRegion.name;
                                
                                if (resourceType === 'circuit' || resourceType === 'chip' || resourceType === 'processor') {
                                    tile.techResource = true;
                                }
                                
                                this.resourceNodes.set(nodeId, {
                                    id: nodeId,
                                    tile: tile,
                                    type: resourceType,
                                    variants: [{ ...selectedVariant }],
                                    col: col,
                                    row: row,
                                    isTechResource: resourceType === 'circuit' || resourceType === 'chip' || resourceType === 'processor'
                                });
                                
                                console.log(`   ✅ Added ${resourceType} at (${col}, ${row}) in ${targetRegion.name}`);
                                placed = true;
                            }
                        }
                        attempts++;
                    }
                });
            }
            
