                                self.withdrawCraftingQueue(queue.id);
                            }, true);
                            
                            // Insert after ingredients div, or append to card if not found
                            if (ingredientsDiv && ingredientsDiv.parentNode) {
                                ingredientsDiv.parentNode.insertBefore(withdrawBtn, ingredientsDiv.nextSibling);
                            } else {
                                card.appendChild(withdrawBtn);
                            }
                        } else if (completed < total && !hasActionBtns) {
                            // Need to show action buttons - remove withdraw button first
                            if (hasWithdrawBtn) {
                                hasWithdrawBtn.remove();
                            }
                            
                            const newActionBtnsContainer = document.createElement('div');
                            newActionBtnsContainer.style.cssText = 'display: flex; gap: 8px; margin-top: 8px;';
                            
                            if (timer && timer.isActive && timer.speedUpPercent < 100) {
                                const speedUpBtn = document.createElement('button');
                                speedUpBtn.className = 'speed-up-craft-btn';
                                speedUpBtn.setAttribute('data-queue-id', queue.id);
                                speedUpBtn.style.cssText = 'padding: 8px 16px; background: #000; color: #ffff00; border: 2px solid #ffff00; cursor: pointer; font-size: 11px; font-family: "Press Start 2P", monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 255, 0, 0.5); transition: all 0.2s; pointer-events: auto; z-index: 100; position: relative;';
                                speedUpBtn.textContent = 'SPEED UP';
                                speedUpBtn.addEventListener('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    console.log('🔥🔥🔥 SPEED UP CLICKED! Queue ID:', queue.id);
                                    self.openSpeedUpMenu(queue.id);
                                }, true);
                                newActionBtnsContainer.appendChild(speedUpBtn);
                            }
                            
                            const cancelBtn = document.createElement('button');
                            cancelBtn.className = 'cancel-craft-btn';
                            cancelBtn.setAttribute('data-queue-id', queue.id);
                            cancelBtn.style.cssText = 'padding: 8px 16px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 11px; font-family: "Press Start 2P", monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.2s; pointer-events: auto; z-index: 100; position: relative;';
                            cancelBtn.textContent = 'CANCEL';
                            cancelBtn.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                console.log('🔥🔥🔥 CANCEL CLICKED! Queue ID:', queue.id);
                                self.cancelCraftingQueue(queue.id);
                            }, true);
                            newActionBtnsContainer.appendChild(cancelBtn);
                            
                            // Find the ingredients div to insert after it
                            const ingredientsDiv = Array.from(card.querySelectorAll('div')).find(div => 
                                div.textContent && div.textContent.includes('INGREDIENTS')
                            );
                            
                            // Insert after ingredients div, or append to card if not found
                            if (ingredientsDiv && ingredientsDiv.parentNode) {
                                ingredientsDiv.parentNode.insertBefore(newActionBtnsContainer, ingredientsDiv.nextSibling);
                            } else {
                                card.appendChild(newActionBtnsContainer);
                            }
                        }
                    }
                    
                    // Remove from map so we know which cards to delete
                    existingCards.delete(queue.id);
                });
                
                // Remove cards for queues that no longer exist
                existingCards.forEach((card) => {
                    card.remove();
                });
            }
            
            /**
             * Get all crafting recipes (non-resource-only)
             */
            getAllCraftingRecipes() {
                const recipes = this.getRecipeDatabase();
                const allRecipes = [
                    ...recipes.resourceToItem || [],
                    ...recipes.itemToRare || [],
                    ...recipes.rareToLegendary || []
                ];
                return allRecipes;
            }
            
            /**
             * Organize recipes by category
             */
            organizeRecipesByCategory(recipes) {
                const organized = {
                    'item': [],
                    'rare': [],
                    'legendary': []
                };
                
                recipes.forEach(recipe => {
                    const category = recipe.category || 'item';
                    if (organized[category]) {
                        organized[category].push(recipe);
                    } else {
                        organized['item'].push(recipe);
                    }
                });
                
                return organized;
            }
            
            /**
             * Create recipe card for available recipes
             */
            createRecipeCard(recipe) {
                const card = document.createElement('div');
                card.style.cssText = 'margin-bottom: 15px; padding: 12px; border: 3px solid #00ff00; background: rgba(0, 0, 0, 0.5); font-family: "Press Start 2P", monospace;';
                
                // Check if player has ingredients
                const hasIngredients = this.checkIngredients(recipe.ingredients);
                const canCraft = hasIngredients && recipe.ingredients.length > 0;
                
                card.innerHTML = `
                    <div style="margin-bottom: 10px;">
                        <div style="font-size: 9px; color: ${canCraft ? '#00ff00' : '#aaa'}; margin-bottom: 5px; text-shadow: 2px 2px 0px #000;">
                            ▶ ${recipe.name}
                        </div>
                        <div style="font-size: 11px; color: #aaa;">
                            ${recipe.category || 'item'} | TIME: ${recipe.time}s
                        </div>
                    </div>
                    <div style="font-size: 11px; color: #aaa; margin-bottom: 10px; border-top: 2px solid #00ff00; padding-top: 8px;">
                        <div style="color: #00ff00; margin-bottom: 5px; text-shadow: 1px 1px 0px #000;">▶ INGREDIENTS:</div>
                        <div style="margin-left: 10px; margin-top: 3px; line-height: 1.8;">
                            ${recipe.ingredients.map(ing => {
                                const hasItem = this.hasItemInInventory(ing.name, ing.quantity);
                                return `<span style="color: ${hasItem ? '#00ff00' : '#ff0000'}; text-shadow: ${hasItem ? '1px 1px 0px #000' : '1px 1px 0px #000'}">• ${ing.quantity}x ${ing.name} ${hasItem ? '✓' : '✗'}</span>`;
                            }).join('<br/>')}
                        </div>
                    </div>
                    <div style="font-size: 11px; color: #ffff00; margin-bottom: 10px; border-top: 2px solid #00ff00; padding-top: 8px; text-shadow: 1px 1px 0px #000;">
                        ▶ OUTPUT: ${recipe.output.name} × ${recipe.output.quantity}
                    </div>
                    ${canCraft ? `
                        <div style="display: flex; gap: 8px; align-items: center; margin-top: 10px;">
                            <input type="number" id="recipe-qty-${recipe.id}" min="1" max="99" value="1" step="1" style="width: 80px; padding: 6px; background: #000; color: #00ff00; border: 2px solid #00ff00; font-family: 'Press Start 2P', monospace; font-size: 12px; text-align: center; -webkit-appearance: none; -moz-appearance: textfield; pointer-events: auto; cursor: text; z-index: 10; position: relative;">
                            <button class="queue-craft-btn" data-recipe-id="${recipe.id}" style="padding: 8px 16px; background: #000; color: #00ff00; border: 2px solid #00ff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(0, 255, 0, 0.5); transition: all 0.1s; position: relative; z-index: 10; pointer-events: auto;" onmouseover="this.style.background='#00ff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#00ff00';">QUEUE</button>
                        </div>
                    ` : `
                        <div style="font-size: 11px; color: #ff0000; margin-top: 8px; text-shadow: 1px 1px 0px #000;">
                            ▶ MISSING INGREDIENTS
                        </div>
                    `}
                `;
                
                return card;
            }
            
            /**
             * Check if player has required ingredients
             */
            checkIngredients(ingredients) {
                return ingredients.every(ing => this.hasItemInInventory(ing.name, ing.quantity));
            }
            
            /**
             * Queue a crafting recipe
             */
            queueCraftingRecipe(recipeId, quantity) {
                if (!this.currentCraftingStation) {
                    alert('No crafting station selected!');
                    return;
                }
                
                const queues = this.craftingQueues.get(this.currentCraftingStation) || [];
                if (queues.length >= this.maxCraftingSlots) {
                    alert('All crafting slots are full!');
                    return;
                }
                
                if (quantity < 1 || quantity > this.maxItemsPerQueue) {
                    alert(`Invalid quantity! Must be between 1 and ${this.maxItemsPerQueue}`);
                    return;
                }
                
                // Find recipe
                const allRecipes = this.getAllCraftingRecipes();
                const recipe = allRecipes.find(r => r.id === recipeId);
                if (!recipe) {
                    alert(`Recipe not found: ${recipeId}`);
                    return;
                }
                
                // Check ingredients
                if (!this.checkIngredients(recipe.ingredients)) {
                    const missing = recipe.ingredients.filter(ing => !this.hasItemInInventory(ing.name, ing.quantity));
                    alert(`Missing ingredients: ${missing.map(m => `${m.quantity}x ${m.name}`).join(', ')}`);
                    return;
                }
                
                // Consume ingredients
                recipe.ingredients.forEach(ing => {
                    this.consumeItemFromInventory(ing.name, ing.quantity * quantity);
                });
                
                // Create queue entry
                const queueId = `craft_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                const queue = {
                    id: queueId,
                    recipe: recipe,
                    quantity: quantity,
                    completed: 0,
                    stationId: this.currentCraftingStation,
                    createdAt: Date.now()
                };
                
                queues.push(queue);
                this.craftingQueues.set(this.currentCraftingStation, queues);
                
                // Start crafting timer if this is the first/only queue
                this.processCraftingQueues();
                
                this.updateCraftingUI();
            }
            
            /**
             * Consume items from inventory (alias for removeFromInventory)
             */
            consumeItemFromInventory(itemName, quantity) {
                return this.removeFromInventory(itemName, quantity);
            }
            
            /**
             * Process crafting queues (start timers)
             * Processes queues for all stations, not just current one
             */
            processCraftingQueues() {
                // Process all stations
                this.craftingQueues.forEach((queues, stationId) => {
                    // Find active queue
                    const activeQueue = queues.find(q => {
                        const timer = this.craftingTimers.get(q.id);
                        return timer && timer.isActive;
                    });
                    
                    if (activeQueue) return; // Already processing one
                    
                    // Find next queue to process (not complete, no active timer)
                    const nextQueue = queues.find(q => {
                        const timer = this.craftingTimers.get(q.id);
                        return !timer && (q.completed || 0) < q.quantity;
                    });
                    
                    if (!nextQueue) return;
                    
                    // Start timer for this queue
                    const recipe = nextQueue.recipe;
                    const baseTime = recipe.time * 1000; // Convert to ms
                    
                    this.craftingTimers.set(nextQueue.id, {
                        isActive: true,
                        startTime: Date.now(),
                        baseTime: recipe.time,
                        speedUpPercent: 0, // Can be increased with Energy Cells
                        queueId: nextQueue.id
                    });
                    
                    // Set timeout to complete one item (will continue automatically)
                    const timerId = setTimeout(() => {
                        this.completeCraftingItem(nextQueue.id);
                    }, baseTime);
                    
                    // Store timeout ID for potential cancellation
                    const timer = this.craftingTimers.get(nextQueue.id);
                    if (timer) {
                        timer.timeoutId = timerId;
                    }
                });
            }
            
            /**
             * Complete one item in crafting queue
             */
            completeCraftingItem(queueId) {
                if (!this.currentCraftingStation) {
                    // Station closed, but continue processing
                    const allStations = Array.from(this.craftingQueues.keys());
                    for (const stationId of allStations) {
                        const queues = this.craftingQueues.get(stationId) || [];
                        const queue = queues.find(q => q.id === queueId);
                        if (queue) {
                            this.processCraftingItemCompletion(stationId, queue);
                            return;
                        }
                    }
                    return;
                }
                
                const queues = this.craftingQueues.get(this.currentCraftingStation) || [];
                const queue = queues.find(q => q.id === queueId);
                if (!queue) return;
                
                this.processCraftingItemCompletion(this.currentCraftingStation, queue);
            }
            
            /**
             * Process completion of one crafting item
             */
            processCraftingItemCompletion(stationId, queue) {
                queue.completed = (queue.completed || 0) + 1;
                
                // Remove timer
                this.craftingTimers.delete(queue.id);
                
                // Don't add to inventory yet - wait for player to click WITHDRAW
                console.log(`✅ Crafted 1x ${queue.recipe.name} (${queue.completed}/${queue.quantity})`);
                
                // If queue is complete, mark it
                if (queue.completed >= queue.quantity) {
                    console.log(`✅ Queue complete: ${queue.quantity}x ${queue.recipe.name}`);
                    // Move to next queue
                    this.processCraftingQueues();
                } else {
                    // Continue crafting next item in THIS queue
                    const recipe = queue.recipe;
                    const baseTime = recipe.time * 1000;
                    
                    this.craftingTimers.set(queue.id, {
                        isActive: true,
                        startTime: Date.now(),
                        baseTime: recipe.time,
                        speedUpPercent: 0,
                        queueId: queue.id
                    });
                    
                    setTimeout(() => {
                        this.completeCraftingItem(queue.id);
                    }, baseTime);
                }
                
                // Update UI if this station is currently open
                if (this.currentCraftingStation === stationId) {
                    this.updateCraftingUI();
                }
            }
            
            /**
             * Withdraw completed crafting queue
             * Adds completed items to inventory and removes the queue
             */
            withdrawCraftingQueue(queueId) {
                if (!this.currentCraftingStation) {
                    alert('No crafting station selected!');
                    return;
                }
                
                const queues = this.craftingQueues.get(this.currentCraftingStation) || [];
                const queue = queues.find(q => q.id === queueId);
                
                if (!queue) {
                    alert('Queue not found!');
                    return;
                }
                
                const completed = queue.completed || 0;
                const total = queue.quantity;
                
                if (completed < total) {
                    alert(`Queue not complete! Only ${completed}/${total} items finished.`);
                    return;
                }
                
                // Add all completed items to inventory now
                const output = queue.recipe.output;
                const itemsToAdd = completed * output.quantity;
                this.addToInventory(output.name, itemsToAdd);
                
                // Remove the queue
                const updatedQueues = queues.filter(q => q.id !== queueId);
                this.craftingQueues.set(this.currentCraftingStation, updatedQueues);
                
                // Remove any timer if it exists
                this.craftingTimers.delete(queueId);
                
                // Process next queue
                this.processCraftingQueues();
                
                // Force full UI update to refresh both queues and recipes
                this.updateCraftingUI();
                
                // Also update recipes in case slots opened up
                const recipesContainer = document.getElementById('available-recipes-container');
                if (recipesContainer) {
                    recipesContainer._recipesInitialized = false; // Reset to allow re-initialization
                    this.updateAvailableRecipes(recipesContainer);
                }
            }
            
            /**
             * Cancel crafting queue
             */
            cancelCraftingQueue(queueId) {
                if (!this.currentCraftingStation) return;
                
                const queues = this.craftingQueues.get(this.currentCraftingStation) || [];
                const queue = queues.find(q => q.id === queueId);
                
                if (!queue) return;
                
                // Refund ingredients for remaining items
                const remaining = queue.quantity - (queue.completed || 0);
                if (remaining > 0) {
                    queue.recipe.ingredients.forEach(ing => {
                        this.addToInventory(ing.name, ing.quantity * remaining);
                    });
                }
                
                // Remove timer if active
                this.craftingTimers.delete(queueId);
                
                // Remove queue
                const updatedQueues = queues.filter(q => q.id !== queueId);
                this.craftingQueues.set(this.currentCraftingStation, updatedQueues);
                
                // Process next queue
                this.processCraftingQueues();
                
                console.log(`✅ Cancelled crafting queue: ${queue.recipe.name}`);
                this.updateCraftingUI();
            }
            
            /**
             * Open speed-up menu for crafting
             */
            openSpeedUpMenu(queueId) {
                if (!this.currentCraftingStation) return;
                
                const timer = this.craftingTimers.get(queueId);
                if (!timer || !timer.isActive) {
                    alert('No active crafting to speed up');
                    return;
                }
                
                this.currentSpeedUpQueue = queueId;
                const modal = document.getElementById('speed-up-modal');
                const content = document.getElementById('speed-up-content');
                
                if (!modal || !content) return;
                
                const currentSpeed = timer.speedUpPercent || 0;
                const maxSpeed = 100; // Can go up to instant (100%)
                const speedPerCell = 10; // 10% per Energy Cell
                const cellsNeeded = Math.ceil((maxSpeed - currentSpeed) / speedPerCell);
                const availableCells = this.energyCells;
                
                // Calculate time reduction
                const baseTime = timer.baseTime; // in seconds
                const currentTime = baseTime * (1 - currentSpeed / 100);
                const maxTime = baseTime * (1 - maxSpeed / 100); // 0 seconds at 100%
                
                content.innerHTML = `
                    <div style="margin-bottom: 20px; padding: 15px; border: 3px solid #ffff00; background: rgba(0, 0, 0, 0.5);">
                        <div style="font-size: 14px; color: #ffff00; margin-bottom: 10px; text-shadow: 2px 2px 0px #000;">
                            ▶ YOUR ENERGY CELLS: ${availableCells}
                        </div>
                        <div style="font-size: 12px; color: #aaa; margin-bottom: 15px;">
                            Current Speed: ${currentSpeed}% | Max: ${maxSpeed}%
                        </div>
                        <div style="font-size: 12px; color: #00ff00; margin-bottom: 10px;">
                            Current Time: ${currentTime.toFixed(1)}s
                        </div>
                        <div style="font-size: 12px; color: #ffff00; margin-bottom: 15px;">
                            ${currentSpeed < maxSpeed ? `Add Energy Cells to reduce time (${speedPerCell}% per cell)` : 'Already at maximum speed!'}
                        </div>
                    </div>
                    
                    <div id="energy-cell-options" style="margin-bottom: 20px;">
                        ${this.renderEnergyCellOptions(currentSpeed, maxSpeed, speedPerCell, availableCells, baseTime)}
                    </div>
                `;
                
                modal.style.display = 'block';
                
                // Attach event listeners
                setTimeout(() => {
                    document.querySelectorAll('.add-energy-cell-btn').forEach(btn => {
                        const newBtn = btn.cloneNode(true);
                        btn.parentNode.replaceChild(newBtn, btn);
                        newBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            const amount = parseInt(newBtn.dataset.amount) || 1;
                            this.addEnergyCellsToCrafting(queueId, amount);
                        });
                    });
                }, 10);
            }
            
            /**
             * Render energy cell options
             */
            renderEnergyCellOptions(currentSpeed, maxSpeed, speedPerCell, availableCells, baseTime) {
                let html = '';
                
                // Show options: 1 cell, 2 cells, 3 cells, or all needed to reach max
                const cellsNeededForMax = Math.ceil((maxSpeed - currentSpeed) / speedPerCell);
                const options = [];
                
                // Always show 1 cell option
                if (availableCells >= 1 && currentSpeed < maxSpeed) {
                    options.push(1);
                }
                
                // Show 2 cells if available
                if (availableCells >= 2 && currentSpeed + (2 * speedPerCell) <= maxSpeed) {
                    options.push(2);
                }
                
                // Show 3 cells if available
                if (availableCells >= 3 && currentSpeed + (3 * speedPerCell) <= maxSpeed) {
                    options.push(3);
                }
                
                // Show "all to max" option if different from above
                if (cellsNeededForMax > 3 && cellsNeededForMax <= availableCells) {
                    options.push(cellsNeededForMax);
                }
                
                options.forEach(cellsToAdd => {
                    const newSpeed = Math.min(maxSpeed, currentSpeed + (cellsToAdd * speedPerCell));
                    const currentTime = baseTime * (1 - currentSpeed / 100);
                    const newTime = baseTime * (1 - newSpeed / 100);
                    const timeReduction = currentTime - newTime;
                    const isInstant = newSpeed >= 100;
                    
                    html += `
                        <div style="margin-bottom: 15px; padding: 12px; border: 2px solid #ffff00; background: rgba(0, 0, 0, 0.5);">
                            <div style="font-size: 12px; color: #ffff00; margin-bottom: 8px;">
                                ▶ ADD ${cellsToAdd} ENERGY CELL${cellsToAdd > 1 ? 'S' : ''}
                            </div>
                            <div style="font-size: 11px; color: #00ff00; margin-bottom: 5px;">
                                Speed: ${currentSpeed}% → ${newSpeed}%${isInstant ? ' (INSTANT!)' : ''}
                            </div>
                            <div style="font-size: 11px; color: #aaa; margin-bottom: 10px;">
                                Time: ${currentTime.toFixed(1)}s → ${isInstant ? '0.0s (INSTANT!)' : newTime.toFixed(1) + 's'} ${timeReduction > 0 ? `(-${timeReduction.toFixed(1)}s)` : ''}
                            </div>
                            <button class="add-energy-cell-btn" data-amount="${cellsToAdd}" style="padding: 8px 16px; background: #000; color: #ffff00; border: 2px solid #ffff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 255, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ffff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ffff00';">ADD ${cellsToAdd} CELL${cellsToAdd > 1 ? 'S' : ''}</button>
                        </div>
                    `;
                });
                
                if (html === '') {
                    html = '<div style="font-size: 12px; color: #00ff00; padding: 15px; text-align: center;">Already at maximum speed or no Energy Cells available!</div>';
                }
                
                return html;
            }
            
            /**
             * Add Energy Cells to crafting queue
             */
            addEnergyCellsToCrafting(queueId, amount) {
                if (!this.currentCraftingStation) return;
                
                const timer = this.craftingTimers.get(queueId);
                if (!timer || !timer.isActive) {
                    alert('No active crafting to speed up');
                    this.closeSpeedUpMenu();
                    return;
                }
                
                if (this.energyCells < amount) {
                    alert(`Not enough Energy Cells! You have ${this.energyCells}, need ${amount}`);
                    return;
                }
                
                const currentSpeed = timer.speedUpPercent || 0;
                const speedPerCell = 10;
                const newSpeed = Math.min(100, currentSpeed + (amount * speedPerCell));
                
                // Spend Energy Cells
                this.energyCells -= amount;
                this.updateEconomyDisplay();
                
                // Update speed
                timer.speedUpPercent = newSpeed;
                
                // Recalculate remaining time
                const elapsed = Date.now() - timer.startTime;
                const baseTime = timer.baseTime * 1000;
                const speedMultiplier = 1 - (newSpeed / 100);
                const adjustedTime = baseTime * speedMultiplier;
                const remainingMs = Math.max(0, adjustedTime - elapsed);
                
                // If instant (100%), complete immediately
                if (newSpeed >= 100 && remainingMs > 0) {
                    clearTimeout(timer.timeoutId);
                    setTimeout(() => {
                        this.completeCraftingItem(queueId);
                    }, 100);
                } else if (remainingMs > 0) {
                    // Restart timer with new time
                    clearTimeout(timer.timeoutId);
                timer.timeoutId = setTimeout(() => {
                    this.completeCraftingItem(queueId);
                }, remainingMs);
                }
                
                // Update UI
                this.updateCraftingUI();
                this.openSpeedUpMenu(queueId); // Refresh menu
            }
            
            /**
             * Close speed-up menu
             */
            closeSpeedUpMenu() {
                const modal = document.getElementById('speed-up-modal');
                if (modal) {
                    modal.style.display = 'none';
                }
                this.currentSpeedUpQueue = null;
            }
            
            /**
             * Speed up crafting with Energy Cells (legacy - now opens menu)
             */
            speedUpCrafting(queueId) {
                this.openSpeedUpMenu(queueId);
            }
            
            /**
             * Update Economy Display (SAND and Energy Cells)
             */
            updateEconomyDisplay() {
                const sandBalance = document.getElementById('sand-balance');
                const energyCells = document.getElementById('energy-cells');
                
                if (sandBalance) {
                    sandBalance.textContent = this.sandBalance.toLocaleString();
                }
                if (energyCells) {
                    energyCells.textContent = this.energyCells;
                }
            }
            
            /**
             * Deliver items to a work order (enters queue, doesn't process immediately)
             */
            deliverToWorkOrder(orderId, quantity, depotId) {
                const order = this.workOrders.find(o => o.id === orderId);
                if (!order || order.status !== 'active') {
                    console.warn(`⚠️  Cannot deliver to order ${orderId} - not found or not active`);
                    return false;
                }
                
                // Check if player has the items
                const itemCount = this.getItemCount(order.item);
                const canDeliver = Math.min(quantity, itemCount, order.quota - order.progress);
                if (canDeliver <= 0) {
                    console.warn(`⚠️  Cannot deliver - insufficient items or order complete`);
                    return false;
                }
                
                // Check if this is the correct depot
                const correctDepotId = order.depotLocation?.depotId;
                const isCorrectDepot = correctDepotId && correctDepotId === depotId;
                const feePercent = isCorrectDepot ? 0 : 25; // 25% fee for wrong depot
                const basePayout = canDeliver * order.payout;
                const finalPayout = Math.floor(basePayout * (1 - feePercent / 100));
                
                // Remove items from inventory
                this.removeFromInventory(order.item, canDeliver);
                
                // Create delivery entry
                const deliveryId = `delivery_${depotId}_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                const delivery = {
                    id: deliveryId,
                    orderId: orderId,
                    item: order.item,
                    quantity: canDeliver,
                    basePayout: basePayout,
                    finalPayout: finalPayout,
                    feePercent: feePercent,
                    isCorrectDepot: isCorrectDepot,
                    depotId: depotId,
                    queuePosition: 0,
                    createdAt: Date.now(),
                    processed: false
                };
                
                // Add to delivery queue for this depot
                if (!this.deliveryQueues.has(depotId)) {
                    this.deliveryQueues.set(depotId, []);
                }
                const queue = this.deliveryQueues.get(depotId);
                queue.push(delivery);
                
                // Update queue positions
                this.updateDeliveryQueuePositions(depotId);
                
                // Start processing queue if not already processing
                this.processDeliveryQueue(depotId);
                
                console.log(`📦 Queued delivery: ${canDeliver}x ${order.item} (Position: ${delivery.queuePosition + 1})`);
                return true;
            }
            
            /**
             * Update queue positions for a depot
             */
            updateDeliveryQueuePositions(depotId) {
                const queue = this.deliveryQueues.get(depotId);
                if (!queue) return;
                
                queue.forEach((delivery, index) => {
                    delivery.queuePosition = index;
                });
            }
            
            /**
             * Process delivery queue (FIFO)
             */
            processDeliveryQueue(depotId) {
                const queue = this.deliveryQueues.get(depotId);
                if (!queue || queue.length === 0) return;
                
                // Check if already processing
                const firstDelivery = queue[0];
                if (this.deliveryQueueTimers.has(firstDelivery.id)) {
                    return; // Already processing
                }
                
                // Start processing first delivery
                const processTime = this.baseDeliveryProcessTime;
                const timerId = setTimeout(() => {
                    this.completeDelivery(firstDelivery.id, depotId);
                }, processTime);
                
                this.deliveryQueueTimers.set(firstDelivery.id, {
                    startTime: Date.now(),
                    duration: processTime,
                    timerId: timerId
                });
            }
            
            /**
             * Complete a delivery and pay player
             */
            completeDelivery(deliveryId, depotId) {
                const queue = this.deliveryQueues.get(depotId);
                if (!queue) return;
                
                const deliveryIndex = queue.findIndex(d => d.id === deliveryId);
                if (deliveryIndex === -1) return;
                
                const delivery = queue[deliveryIndex];
                const order = this.workOrders.find(o => o.id === delivery.orderId);
                
                if (!order || order.status !== 'active') {
                    // Order no longer valid, remove delivery
                    queue.splice(deliveryIndex, 1);
                    this.deliveryQueueTimers.delete(deliveryId);
                    this.updateDeliveryQueuePositions(depotId);
                    this.processDeliveryQueue(depotId);
                    return;
                }
                
                // Update order progress
                const canDeliver = Math.min(delivery.quantity, order.quota - order.progress);
                order.progress += canDeliver;
                
                // Pay player (use finalPayout which already has fee applied)
                const payout = delivery.finalPayout || (canDeliver * order.payout);
                this.sandBalance += payout;
                this.updateEconomyDisplay();
                
                const feeText = delivery.feePercent > 0 ? ` (${delivery.feePercent}% fee applied, lost ${delivery.basePayout - payout} SAND)` : ' (100% reward)';
                console.log(`✅ Delivered ${canDeliver} ${order.item} - Earned ${payout} SAND${feeText}`);
                
                // Check if order is complete
                if (order.progress >= order.quota) {
                    order.status = 'completed';
                    console.log(`🎉 Work Order ${order.item} for ${order.megacorp} is COMPLETE!`);
                }
                
                // Remove delivery from queue
                queue.splice(deliveryIndex, 1);
                this.deliveryQueueTimers.delete(deliveryId);
                
                // Update positions and continue processing
                this.updateDeliveryQueuePositions(depotId);
                this.checkWorkOrderCompletion();
                this.updateWorkOrdersUI();
                
                // Continue processing next delivery
                this.processDeliveryQueue(depotId);
                
                // Update delivery UI if open
                if (this.currentDeliveryDepot === depotId) {
                    this.updateDeliveryUI();
                }
            }
            
            /**
             * Speed up delivery queue with Energy Cells
             */
            speedUpDelivery(deliveryId, depotId) {
                if (this.energyCells < 1) {
                    console.warn('⚠️  Not enough Energy Cells');
                    return false;
                }
                
                const queue = this.deliveryQueues.get(depotId);
                if (!queue) return false;
                
                const delivery = queue.find(d => d.id === deliveryId);
                if (!delivery) return false;
                
                // If not first in queue, move it to position 1
                if (delivery.queuePosition > 0) {
                    // Remove from current position
                    queue.splice(delivery.queuePosition, 1);
                    // Insert at position 0 (after current processing)
                    queue.splice(1, 0, delivery);
                    this.updateDeliveryQueuePositions(depotId);
                }
                
                // Spend Energy Cell
                this.energyCells--;
                this.updateEconomyDisplay();
                
                // If this is the next delivery, reduce processing time
                if (delivery.queuePosition === 1) {
                    const timer = this.deliveryQueueTimers.get(queue[0]?.id);
                    if (timer) {
                        // Reduce remaining time by 50%
                        const remaining = timer.duration - (Date.now() - timer.startTime);
                        clearTimeout(timer.timerId);
                        
                        const newTime = Math.max(500, remaining * 0.5); // At least 500ms
                        const newTimerId = setTimeout(() => {
                            this.completeDelivery(queue[0].id, depotId);
                        }, newTime);
                        
                        timer.timerId = newTimerId;
                        timer.duration = newTime;
                        timer.startTime = Date.now();
                    }
                }
                
                console.log(`⚡ Sped up delivery with Energy Cell`);
                this.updateDeliveryUI();
                return true;
            }
            
