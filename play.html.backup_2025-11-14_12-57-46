            /**
             * Check if item is fragile (requires energy cell to craft)
             */
            isFragileItem(itemName) {
                // Define which items are fragile - these require energy cells to craft
                const fragileItems = [
                    'Quantum Computer', 'Cryogenic Cooling Unit', 'Quantum Control Device',
                    'High-Performance CPU', 'Quantum Chip', 'Advanced Circuit'
                ];
                return fragileItems.includes(itemName);
            }
            
            /**
             * Mark item as fragile when added to inventory
             */
            markItemAsFragile(slotIndex, itemName) {
                if (this.isFragileItem(itemName)) {
                    const expiresAt = Date.now() + this.fragileItemDuration;
                    this.fragileItemTimers.set(slotIndex, { expiresAt, itemName });
                    console.log(`⏱️ Fragile item ${itemName} added to slot ${slotIndex}, expires in 25 minutes`);
                }
            }
            
            /**
             * Check and remove expired fragile items
             */
            checkFragileItems() {
                const now = Date.now();
                const expiredSlots = [];
                
                this.fragileItemTimers.forEach((timer, slotIndex) => {
                    if (now >= timer.expiresAt) {
                        expiredSlots.push(slotIndex);
                    }
                });
                
                expiredSlots.forEach(slotIndex => {
                    const slot = this.sharedInventory[slotIndex];
                    if (slot && this.isFragileItem(slot.item)) {
                        console.log(`💥 Fragile item ${slot.item} expired in slot ${slotIndex}, removing...`);
                        this.sharedInventory[slotIndex] = null;
                        this.fragileItemTimers.delete(slotIndex);
                        this.updateCurrentWeight();
                        if (this.inventoryModalOpen) {
                            this.renderInventoryUI();
                        }
                    }
                });
            }
            
            /**
             * Get time remaining for fragile item
             */
            getFragileItemTimeRemaining(slotIndex) {
                const timer = this.fragileItemTimers.get(slotIndex);
                if (!timer) return null;
                
                const remaining = timer.expiresAt - Date.now();
                if (remaining <= 0) return 0;
                
                const minutes = Math.floor(remaining / 60000);
                const seconds = Math.floor((remaining % 60000) / 1000);
                return { minutes, seconds, totalMs: remaining };
            }
            
            /**
             * Update daily reward UI
             */
            updateDailyRewardUI() {
                const statusEl = document.getElementById('daily-reward-status');
                const timerEl = document.getElementById('daily-reward-timer');
                const claimBtn = document.getElementById('claim-daily-reward-btn');
                
                if (!statusEl || !timerEl || !claimBtn) return;
                
                const now = Date.now();
                const canClaim = !this.lastDailyRewardClaim || (now - this.lastDailyRewardClaim) >= this.dailyRewardCooldown;
                
                if (canClaim) {
                    statusEl.textContent = 'READY TO CLAIM';
                    statusEl.style.color = '#00ff00';
                    timerEl.textContent = 'Next: 24h 00m 00s';
                    claimBtn.disabled = false;
                    claimBtn.style.opacity = '1';
                } else {
                    statusEl.textContent = 'ON COOLDOWN';
                    statusEl.style.color = '#ff0000';
                    const remaining = this.dailyRewardCooldown - (now - this.lastDailyRewardClaim);
                    const hours = Math.floor(remaining / (60 * 60 * 1000));
                    const minutes = Math.floor((remaining % (60 * 60 * 1000)) / (60 * 1000));
                    const seconds = Math.floor((remaining % (60 * 1000)) / 1000);
                    timerEl.textContent = `Next: ${hours}h ${minutes}m ${seconds}s`;
                    claimBtn.disabled = true;
                    claimBtn.style.opacity = '0.5';
                }
            }
            
