<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebGL Sandbox Multiplayer - Play Now</title>
    <style>
        /* Button hover effects */
        .withdraw-craft-btn:hover {
            background: #00ff00 !important;
            color: #000 !important;
            transform: scale(1.05);
        }
        .speed-up-craft-btn:hover {
            background: #ffff00 !important;
            color: #000 !important;
            transform: scale(1.05);
        }
        .cancel-craft-btn:hover {
            background: #ff0000 !important;
            color: #000 !important;
            transform: scale(1.05);
        }
        .queue-craft-btn:hover {
            background: #00ff00 !important;
            color: #000 !important;
            transform: scale(1.05);
        }
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            image-rendering: pixelated;
            image-rendering: -moz-crisp-edges;
            image-rendering: crisp-edges;
            scrollbar-width: thin;
            scrollbar-color: #00ff00 rgba(0, 0, 0, 0.5);
        }
        
        /* Retro Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 12px;
        }
        
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.5);
            border: 2px solid #00ff00;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #00ff00;
            border: 2px solid #000;
            box-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #00cc00;
        }

        body {
            overflow: hidden;
            font-family: 'Press Start 2P', monospace;
            background: #1a1a2e;
            color: #fff;
        }
        
        /* CRT Scanline Effect */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.15),
                rgba(0, 0, 0, 0.15) 1px,
                transparent 1px,
                transparent 2px
            );
            pointer-events: none;
            z-index: 9999;
        }

        #canvas-container {
            width: 100vw;
            height: 100vh;
            cursor: default;
        }

        #hud {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.7);
            padding: 15px;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            z-index: 100;
            min-width: 200px;
        }

        #wallet-info {
            margin-bottom: 10px;
        }

        #wallet-id {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #4CAF50;
            word-break: break-all;
        }

        #stamina-container {
            margin: 10px 0;
        }

        #stamina-label {
            font-size: 12px;
            margin-bottom: 5px;
        }

        #stamina-bar {
            width: 100%;
            height: 20px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
            overflow: hidden;
        }

        #stamina-fill {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, #4CAF50, #8BC34A);
            transition: width 0.3s ease;
        }

        #controls {
            margin-top: 15px;
        }

        button {
            background: #2196F3;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            margin-right: 10px;
            transition: background 0.3s;
        }

        button:hover {
            background: #1976D2;
        }

        button:disabled {
            background: #666;
            cursor: not-allowed;
        }

        #connect-btn {
            background: #4CAF50;
        }

        #connect-btn:hover {
            background: #45a049;
        }

        #status {
            margin-top: 10px;
            font-size: 11px;
            color: #aaa;
        }

        /* Avatar Modal Styles */
        #avatar-modal {
            backdrop-filter: blur(5px);
        }

        #avatar-modal img {
            border-radius: 4px;
        }

        #avatar-modal button:hover {
            opacity: 0.9;
            transform: scale(1.05);
        }

        #avatar-modal button:active {
            transform: scale(0.95);
        }
        
        /* Retro Terminal Scrollbar */
        #work-orders-container::-webkit-scrollbar {
            width: 12px;
        }
        
        #work-orders-container::-webkit-scrollbar-track {
            background: rgba(0, 20, 0, 0.5);
            border-left: 1px solid #00aa00;
        }
        
        #work-orders-container::-webkit-scrollbar-thumb {
            background: #00ff00;
            border: 1px solid #00aa00;
            box-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
        }
        
        #work-orders-container::-webkit-scrollbar-thumb:hover {
            background: #00cc00;
        }
        
        /* Firefox scrollbar */
        #work-orders-container {
            scrollbar-width: thin;
            scrollbar-color: #00ff00 rgba(0, 20, 0, 0.5);
        }
    </style>
</head>
<body>
    <div id="canvas-container"></div>
    <div id="hud" style="position: fixed; top: 10px; left: 10px; background: rgba(26, 26, 46, 0.95); padding: 15px; border: 3px solid #00ff00; box-shadow: 0 0 10px rgba(0, 255, 0, 0.5), inset 0 0 10px rgba(0, 255, 0, 0.2); color: #00ff00; font-size: 16px; z-index: 100; max-width: 350px; font-family: 'Press Start 2P', monospace; line-height: 1.6;">
        <div style="margin-bottom: 15px; border-bottom: 2px solid #00ff00; padding-bottom: 10px;">
            <div style="font-size: 16px; margin-bottom: 8px; color: #00ff00; text-shadow: 2px 2px 0px #000;">▶ PLAYER INFO</div>
            <div style="font-size: 12px; margin-bottom: 5px;">WALLET: <span id="wallet-id" style="color: #ffff00;">NOT CONNECTED</span></div>
            <div style="margin-top: 10px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 5px; font-size: 12px;">
                    <span>STAMINA:</span>
                    <span id="stamina-value" style="color: #ffff00;">100</span>
                </div>
                <div id="stamina-bar" style="width: 100%; height: 16px; background: #000; border: 2px solid #00ff00; overflow: hidden; box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.8);">
                    <div id="stamina-fill" style="height: 100%; background: repeating-linear-gradient(90deg, #00ff00 0px, #00ff00 4px, #00cc00 4px, #00cc00 8px); width: 100%; transition: width 0.2s; box-shadow: 0 0 5px rgba(0, 255, 0, 0.8);"></div>
                </div>
            </div>
        </div>
        <div style="margin-top: 10px; font-size: 12px; border-top: 2px solid #00ff00; padding-top: 10px;">
            <div style="margin-bottom: 8px;">PLAYERS: <span id="player-count" style="color: #ffff00;">0</span>/8</div>
            <button id="connect-btn" style="margin-top: 8px; padding: 10px 20px; background: #000; color: #00ff00; border: 2px solid #00ff00; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(0, 255, 0, 0.5); transition: all 0.1s; width: 100%;" onmouseover="this.style.background='#00ff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#00ff00';" onclick="if(window.game) window.game.connectMetaMask();">CONNECT METAMASK</button>
            <button id="grid-toggle" style="margin-top: 8px; padding: 10px 20px; background: #000; color: #00ff00; border: 2px solid #00ff00; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(0, 255, 0, 0.5); transition: all 0.1s; width: 100%;" onmouseover="this.style.background='#00ff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#00ff00';">TOGGLE GRID</button>
            <button id="work-orders-btn" style="margin-top: 8px; padding: 10px 20px; background: #000; color: #ffff00; border: 2px solid #ffff00; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 255, 0, 0.5); transition: all 0.1s; width: 100%;" onmouseover="this.style.background='#ffff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ffff00';">WORK ORDERS</button>
        </div>
        <div id="tile-info" style="margin-top: 10px; font-size: 12px; color: #ffff00; border-top: 2px solid #00ff00; padding-top: 10px;">
            <div>TILE: <span id="tile-coords" style="color: #00ff00;">-</span></div>
        </div>
        <div id="connection-status" style="margin-top: 8px; font-size: 12px; border-top: 2px solid #00ff00; padding-top: 10px;">
            <span id="connection-indicator" style="color: #ff0000;">■</span> <span id="connection-text" style="color: #ff0000;">CONNECTING...</span>
        </div>
        <div style="margin-top: 10px; font-size: 12px; border-top: 2px solid #00ff00; padding-top: 10px;">
            <div style="color: #00ff00; margin-bottom: 5px;">▶ ECONOMY</div>
            <div style="margin-bottom: 4px;">SAND: <span id="sand-balance" style="color: #ffff00;">0</span></div>
            <div style="margin-bottom: 4px;">ENERGY: <span id="energy-cells" style="color: #ffff00;">0</span></div>
        </div>
        <div id="daily-reward-section" style="margin-top: 10px; font-size: 12px; border-top: 2px solid #00ff00; padding-top: 10px;">
            <div style="color: #ffff00; margin-bottom: 5px;">▶ DAILY REWARD</div>
            <div id="daily-reward-status" style="margin-bottom: 4px; color: #00ff00;">READY TO CLAIM</div>
            <div id="daily-reward-timer" style="margin-bottom: 4px; color: #aaa; font-size: 11px;">Next: 24h 00m 00s</div>
            <button id="claim-daily-reward-btn" style="padding: 8px 16px; background: #000; color: #00ff00; border: 2px solid #00ff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(0, 255, 0, 0.5); transition: all 0.1s; margin-top: 5px;" onmouseover="this.style.background='#00ff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#00ff00';">CLAIM 5 CELLS</button>
        </div>
        <div style="margin-top: 10px; font-size: 12px; border-top: 2px solid #00ff00; padding-top: 10px;">
            <button id="open-shop-btn" style="padding: 10px 20px; background: #000; color: #ffff00; border: 2px solid #ffff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 255, 0, 0.5); transition: all 0.1s; width: 100%;" onmouseover="this.style.background='#ffff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ffff00';">▶ SHOP</button>
        </div>
        <div id="route-info" style="display: none; margin-top: 10px; padding: 10px; background: rgba(0, 0, 0, 0.9); border: 2px solid #00ff00; box-shadow: 0 0 10px rgba(0, 255, 0, 0.5); font-size: 12px; border-top: 2px solid #00ff00; padding-top: 10px;">
            <div style="color: #ffff00; margin-bottom: 8px; text-shadow: 2px 2px 0px #000;">▶ ROUTE PLOT</div>
            <div style="margin-bottom: 4px;">STAMINA: <span id="route-stamina" style="color: #00ff00;">0</span> / <span id="available-stamina" style="color: #ffff00;">100</span></div>
            <div style="margin-bottom: 4px;">TIME: <span id="route-time" style="color: #00ff00;">0</span>s</div>
            <div>TILES: <span id="route-tiles" style="color: #00ff00;">0</span></div>
        </div>
            <div style="margin-top: 15px; font-size: 11px; color: #888; line-height: 1.8; border-top: 2px solid #00ff00; padding-top: 10px;">
                <div style="color: #00ff00; margin-bottom: 5px;">▶ CONTROLS</div>
                <div>■ CLICK & DRAG: PAN MAP</div>
                <div>■ SCROLL: ZOOM (0.1× - 20×)</div>
                <div style="color: #ffff00;">■ LEFT-CLICK AVATAR: START ROUTE</div>
                <div>■ DRAG: PLAN PATH</div>
                <div>■ RELEASE: EXECUTE</div>
                <div>■ RIGHT-CLICK: WAYPOINT (when plotting)</div>
                <div style="color: #888; margin-top: 8px;">■ F12: OPEN CONSOLE</div>
                <div style="color: #888;">■ RIGHT-CLICK: CONSOLE (when not plotting)</div>
            </div>
    </div>

    <!-- Avatar Selection Modal -->
    <div id="avatar-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; overflow-y: auto; font-family: 'Press Start 2P', monospace;">
        <div style="max-width: 800px; margin: 50px auto; background: rgba(26, 26, 46, 0.98); border: 4px solid #00ff00; box-shadow: 0 0 30px rgba(0, 255, 0, 0.8), inset 0 0 20px rgba(0, 255, 0, 0.2); padding: 30px; color: #00ff00;">
            <h2 style="margin-top: 0; text-align: center; font-size: 16px; text-shadow: 3px 3px 0px #000; color: #ffff00; margin-bottom: 20px;">▶ SELECT AVATAR</h2>
            <div id="avatars-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 20px; margin-bottom: 20px;">
                <!-- Avatars will be inserted here -->
            </div>
            <div style="text-align: center; margin-top: 20px;">
                <button id="create-default-avatar" style="margin-top: 20px; padding: 12px 24px; background: #000; color: #00ff00; border: 3px solid #00ff00; cursor: pointer; font-size: 14px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 10px rgba(0, 255, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#00ff00'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#00ff00';">CREATE DEFAULT</button>
                <button id="close-avatar-modal" style="margin-top: 10px; margin-left: 10px; padding: 10px 20px; background: #000; color: #ff0000; border: 3px solid #ff0000; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 10px rgba(255, 0, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ff0000'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ff0000';">CLOSE</button>
            </div>
        </div>
    </div>

    <!-- Hover Tooltip -->
    <div id="hover-tooltip" style="display: none; position: fixed; pointer-events: none; z-index: 10000; background: rgba(0, 0, 0, 0.9); border: 2px solid #00ff00; padding: 12px; font-family: 'Press Start 2P', monospace; font-size: 14px; color: #00ff00; box-shadow: 0 0 10px rgba(0, 255, 0, 0.5); text-shadow: 2px 2px 0px #000;">
        <div id="tooltip-text"></div>
    </div>

    <!-- Resource Extraction Modal -->
    <div id="resource-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; overflow-y: auto; font-family: 'Press Start 2P', monospace;">
        <div style="max-width: 500px; margin: 50px auto; background: rgba(26, 26, 46, 0.98); border: 4px solid #00ff00; box-shadow: 0 0 30px rgba(0, 255, 0, 0.8), inset 0 0 20px rgba(0, 255, 0, 0.2); padding: 20px; color: #00ff00;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 18px; text-shadow: 3px 3px 0px #000; color: #00ff00;">▶ RESOURCE NODE</h2>
                <button id="close-resource-modal" style="padding: 10px 20px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ff0000'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ff0000';">CLOSE</button>
            </div>
            <div id="resource-variants-container" style="margin-bottom: 15px;">
                <!-- Resource variants will be inserted here -->
            </div>
            <div id="resource-extraction-queue" style="border-top: 2px solid #00ff00; padding-top: 15px;">
                <div style="color: #ffff00; margin-bottom: 10px; font-size: 14px;">▶ EXTRACTION QUEUE</div>
                <div id="extraction-queue-list" style="font-size: 12px; color: #aaa;">
                    <!-- Extraction queue items will be inserted here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Work Orders Modal -->
    <div id="work-orders-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; overflow-y: auto; font-family: 'Press Start 2P', monospace;">
        <div style="max-width: 800px; margin: 30px auto; background: rgba(26, 26, 46, 0.98); border: 4px solid #ffff00; box-shadow: 0 0 30px rgba(255, 255, 0, 0.8), inset 0 0 20px rgba(255, 255, 0, 0.2); padding: 25px; color: #ffff00;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 14px; text-shadow: 3px 3px 0px #000; color: #ffff00;">▶ WORK ORDERS</h2>
                <button id="close-work-orders" style="padding: 8px 16px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ff0000'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ff0000';">CLOSE</button>
            </div>
            <div id="work-orders-container" style="max-height: 70vh; overflow-y: auto;">
                <!-- Work orders will be inserted here -->
            </div>
        </div>
    </div>

    <!-- Crafting Station Modal -->
    <div id="crafting-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; overflow-y: auto; font-family: 'Press Start 2P', monospace;">
        <div style="max-width: 900px; margin: 30px auto; background: rgba(26, 26, 46, 0.98); border: 4px solid #00ff00; box-shadow: 0 0 30px rgba(0, 255, 0, 0.8), inset 0 0 20px rgba(0, 255, 0, 0.2); padding: 25px; color: #00ff00;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 14px; text-shadow: 3px 3px 0px #000; color: #00ff00;">▶ CRAFTING STATION</h2>
                <button id="close-crafting-modal" style="padding: 8px 16px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ff0000'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ff0000';">CLOSE</button>
            </div>
            
            <!-- Active Queues Section -->
            <div style="margin-bottom: 25px; border-bottom: 3px solid #00ff00; padding-bottom: 15px;">
                <div style="font-size: 14px; color: #ffff00; margin-bottom: 15px; text-shadow: 2px 2px 0px #000;">
                    ▶ ACTIVE QUEUES [<span id="active-queues-count">0</span>/3]
                </div>
                <div id="crafting-queues-container" style="margin-bottom: 10px;">
                    <!-- Active queues will be inserted here -->
                </div>
            </div>
            
            <!-- Available Recipes Section -->
            <div>
                <div style="font-size: 14px; color: #ffff00; margin-bottom: 15px; text-shadow: 2px 2px 0px #000;">
                    ▶ AVAILABLE RECIPES
                </div>
                <div id="available-recipes-container" style="max-height: 50vh; overflow-y: auto; pointer-events: auto; position: relative; z-index: 1;">
                    <!-- Available recipes will be inserted here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Speed Up Crafting Modal -->
    <div id="speed-up-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 2000; overflow-y: auto; font-family: 'Press Start 2P', monospace;">
        <div style="max-width: 600px; margin: 50px auto; background: rgba(26, 26, 46, 0.98); border: 4px solid #ffff00; box-shadow: 0 0 30px rgba(255, 255, 0, 0.8), inset 0 0 20px rgba(255, 255, 0, 0.2); padding: 25px; color: #ffff00;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 14px; text-shadow: 3px 3px 0px #000; color: #ffff00;">▶ SPEED UP CRAFTING</h2>
                <button id="close-speed-up-modal" style="padding: 8px 16px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ff0000'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ff0000';">CLOSE</button>
            </div>
            
            <div id="speed-up-content" style="margin-bottom: 20px;">
                <!-- Content will be inserted here -->
            </div>
        </div>
    </div>

    <!-- Delivery Depot Modal -->
    <div id="delivery-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; overflow-y: auto; font-family: 'Press Start 2P', monospace;">
        <div style="max-width: 800px; margin: 30px auto; background: rgba(26, 26, 46, 0.98); border: 4px solid #00ffff; box-shadow: 0 0 30px rgba(0, 255, 255, 0.8), inset 0 0 20px rgba(0, 255, 255, 0.2); padding: 25px; color: #00ffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 14px; text-shadow: 3px 3px 0px #000; color: #00ffff;">▶ DELIVERY DEPOT</h2>
                <button id="close-delivery-modal" style="padding: 8px 16px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 12px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.1s;" onmouseover="this.style.background='#ff0000'; this.style.color='#000';" onmouseout="this.style.background='#000'; this.style.color='#ff0000';">CLOSE</button>
            </div>
            
            <!-- Active Deliveries Queue -->
            <div style="margin-bottom: 25px; border-bottom: 3px solid #00ffff; padding-bottom: 15px;">
                <div style="font-size: 14px; color: #ffff00; margin-bottom: 15px; text-shadow: 2px 2px 0px #000;">
                    ▶ DELIVERY QUEUE
                </div>
                <div id="delivery-queue-container">
                    <!-- Delivery queue items will be inserted here -->
                </div>
            </div>
            
