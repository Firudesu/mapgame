            /**
             * Update available recipes display
             */
            updateAvailableRecipes(container) {
                // Only update if container is empty or first time
                if (container.children.length > 0 && container._recipesInitialized) {
                    return; // Don't recreate if already initialized
                }
                
                // Store current scroll position
                const scrollPos = container.scrollTop;
                
                container.innerHTML = '';
                
                const allRecipes = this.getAllCraftingRecipes();
                const queues = this.craftingQueues.get(this.currentCraftingStation) || [];
                const availableSlots = this.maxCraftingSlots - queues.length;
                
                if (availableSlots <= 0) {
                    container.innerHTML = `
                        <div style="color: #ff0000; font-size: 12px; padding: 15px; border: 3px solid #ff0000; background: rgba(0, 0, 0, 0.5); font-family: 'Press Start 2P', monospace; text-shadow: 2px 2px 0px #000;">
                            ▶ FULL: ALL SLOTS IN USE (3/3)
                        </div>
                    `;
                    return;
                }
                
                // Organize recipes by category
                const organizedRecipes = this.organizeRecipesByCategory(allRecipes);
                
                // Category names and colors
                const categoryInfo = {
                    'item': { name: 'BASIC ITEMS', color: '#00ff00', count: organizedRecipes.item.length },
                    'rare': { name: 'RARE ITEMS', color: '#ffff00', count: organizedRecipes.rare.length },
                    'legendary': { name: 'LEGENDARY ITEMS', color: '#ff00ff', count: organizedRecipes.legendary.length }
                };
                
                // Display recipes by category
                let isFirstCategory = true;
                ['item', 'rare', 'legendary'].forEach(category => {
                    const recipes = organizedRecipes[category];
                    if (recipes.length === 0) return;
                    
                    const info = categoryInfo[category];
                    
                    // Category header
                    const header = document.createElement('div');
                    const topMargin = isFirstCategory ? '0px' : '20px';
                    header.style.cssText = `margin-top: ${topMargin}; margin-bottom: 10px; padding: 8px; border: 2px solid ${info.color}; background: rgba(0, 0, 0, 0.7); font-family: "Press Start 2P", monospace;`;
                    header.innerHTML = `
                        <div style="font-size: 12px; color: ${info.color}; text-shadow: 2px 2px 0px #000;">
                            ▶ ${info.name} (${info.count})
                        </div>
                    `;
                    container.appendChild(header);
                    
                    // Recipes in this category
                    recipes.forEach((recipe) => {
                    const recipeCard = this.createRecipeCard(recipe);
                    container.appendChild(recipeCard);
                    });
                    
                    isFirstCategory = false;
                });
                
                // Restore scroll position
                container.scrollTop = scrollPos;
                
                // Attach event listener only once
                if (!container._recipeClickHandler) {
                    const clickHandler = (e) => {
                        // Check if clicked element or its parent is the button
                        let btn = e.target;
                        let depth = 0;
                        while (btn && btn !== container && depth < 10) {
                            if (btn.classList && btn.classList.contains('queue-craft-btn')) {
                                break;
                            }
                            btn = btn.parentElement;
                            depth++;
                        }
                        
                        if (!btn || !btn.classList || !btn.classList.contains('queue-craft-btn')) {
                            return;
                        }
                        
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const recipeId = btn.dataset.recipeId || btn.getAttribute('data-recipe-id');
                        if (!recipeId) {
                            alert('Error: No recipe ID found');
                            return;
                        }
                        
                        const qtyInput = document.getElementById(`recipe-qty-${recipeId}`);
                        const quantity = qtyInput ? parseInt(qtyInput.value) || 1 : 1;
                        if (quantity < 1 || quantity > 99) {
                            alert('Quantity must be between 1 and 99');
                            return;
                        }
                        
                        // Call the queue function
                        this.queueCraftingRecipe(recipeId, quantity);
                    };
                    
                    container._recipeClickHandler = clickHandler;
                    container.addEventListener('click', clickHandler, true); // Use capture phase
                    container._recipesInitialized = true;
                }
            }
            
