                    if (now >= this.nextResourceRotation) {
                        this.rotateResourceVariants();
                    }
                }, 60000); // Check every minute
            }
            
            /**
             * Format time remaining until next rotation
             */
            getTimeUntilRotation() {
                const now = Date.now();
                const remaining = Math.max(0, this.nextResourceRotation - now);
                
                if (remaining === 0) return 'ROTATING NOW...';
                
                const hours = Math.floor(remaining / (60 * 60 * 1000));
                const minutes = Math.floor((remaining % (60 * 60 * 1000)) / (60 * 1000));
                const seconds = Math.floor((remaining % (60 * 1000)) / 1000);
                
                if (hours > 0) {
                    return `${hours}h ${minutes}m`;
                } else if (minutes > 0) {
                    return `${minutes}m ${seconds}s`;
                } else {
                    return `${seconds}s`;
                }
            }
            
