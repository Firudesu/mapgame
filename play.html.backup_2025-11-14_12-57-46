                                    console.log('🎯 Clicked on player - starting route plotting');
                                    this.startRoutePlotting(clickedTile);
                                    return; // Don't start camera drag
                                }
                            }
                        }
                        
                        // Normal camera drag (if not route plotting)
                        if (!this.isPlottingRoute) {
                            this.isDragging = true;
                            this.lastMousePos.set(e.clientX, e.clientY);
                            canvas.style.cursor = 'grabbing';
                        }
                    }
                });

                canvas.addEventListener('mousemove', (e) => {
                    if (this.isPlottingRoute) {
                        // Route plotting takes priority - update route as mouse moves
                        this.updateRoute(e);
                        return;
                    }
                    
                    if (this.isDragging) {
                        // Camera panning
                        const deltaX = e.clientX - this.lastMousePos.x;
                        const deltaY = e.clientY - this.lastMousePos.y;
                        
                        // Convert screen delta to world delta
                        const aspect = window.innerWidth / window.innerHeight;
                        const viewSize = 2000 / this.zoomLevel;
                        const worldDeltaX = (deltaX / window.innerWidth) * viewSize * aspect * 2;
                        const worldDeltaY = -(deltaY / window.innerHeight) * viewSize * 2;
                        
                        this.cameraPosition.x -= worldDeltaX;
                        this.cameraPosition.y -= worldDeltaY;
                        this.cameraNeedsUpdate = true; // Mark camera as needing update
                        
                        this.lastMousePos.set(e.clientX, e.clientY);
                    }
                });

                canvas.addEventListener('mouseup', (e) => {
                    if (e.button === 0) {
                        this.isDragging = false;
                        canvas.style.cursor = 'default';
                        
                        // Finish route plotting if active
                        if (this.isPlottingRoute) {
                            this.finishRoutePlotting();
                        }
                    }
                });

                canvas.addEventListener('mouseleave', () => {
                    this.isDragging = false;
                    canvas.style.cursor = 'default';
                });

                // Zoom with mouse wheel (0.1x - 20.0x) - smooth interpolation towards player
                canvas.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    const zoomSpeed = 0.12; // Smoother zoom speed
                    const oldZoom = this.targetZoomLevel;
                    const zoomDelta = e.deltaY > 0 ? -zoomSpeed : zoomSpeed;
                    this.targetZoomLevel = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoomLevel + zoomDelta));
                    
                    // Get player position to zoom towards
                    const player = this.players.get(this.currentWallet);
                    if (player) {
                        // Calculate zoom center based on player position
                        const zoomFactor = this.targetZoomLevel / oldZoom;
                        const playerWorldX = player.position.x;
                        const playerWorldY = player.position.y;
                        
                        // Adjust camera position to zoom towards player
                        const aspect = window.innerWidth / window.innerHeight;
                        const oldViewSize = 2000 / oldZoom;
                        const newViewSize = 2000 / this.targetZoomLevel;
                        
                        // Calculate offset to keep player at same screen position
                        const mouseWorldX = this.cameraPosition.x + (e.clientX / window.innerWidth - 0.5) * oldViewSize * aspect * 2;
                        const mouseWorldY = this.cameraPosition.y - (e.clientY / window.innerHeight - 0.5) * oldViewSize * 2;
                        
                        // Zoom towards player position
                        const zoomCenterX = playerWorldX;
                        const zoomCenterY = playerWorldY;
                        
                        // Adjust camera to zoom towards player
                        this.cameraPosition.x = zoomCenterX - (zoomCenterX - this.cameraPosition.x) * zoomFactor;
                        this.cameraPosition.y = zoomCenterY - (zoomCenterY - this.cameraPosition.y) * zoomFactor;
                    }
                    
                    this.cameraNeedsUpdate = true;
                });

                // Arrow keys for zoom (0.1x - 20.0x) - zoom towards player
                window.addEventListener('keydown', (e) => {
                    this.keys[e.key] = true;
                    if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
                        e.preventDefault();
                        const zoomSpeed = 0.12; // Smooth zoom speed
                        const oldZoom = this.targetZoomLevel;
                        const zoomDelta = e.key === 'ArrowUp' ? zoomSpeed : -zoomSpeed;
                        this.targetZoomLevel = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoomLevel + zoomDelta));
                        
                        // Get player position to zoom towards
                        const player = this.players.get(this.currentWallet);
                        if (player) {
                            const zoomFactor = this.targetZoomLevel / oldZoom;
                            const playerWorldX = player.position.x;
                            const playerWorldY = player.position.y;
                            
                            // Zoom towards player position
                            this.cameraPosition.x = playerWorldX - (playerWorldX - this.cameraPosition.x) * zoomFactor;
                            this.cameraPosition.y = playerWorldY - (playerWorldY - this.cameraPosition.y) * zoomFactor;
                        }
                        
                        this.cameraNeedsUpdate = true;
                    }
                    
                    // Debug key: F8 to give work order items
                    if (e.key === 'F8') {
                        e.preventDefault();
                        this.debugGiveWorkOrderItems();
                    }
                    
                    // Inventory key: I to open inventory
                    if (e.key === 'i' || e.key === 'I') {
                        e.preventDefault();
                        this.openInventory();
                    }
                });

                window.addEventListener('keyup', (e) => {
                    this.keys[e.key] = false;
                });
            }

            updateCamera() {
                const aspect = window.innerWidth / window.innerHeight;
                const viewSize = 2000 / this.zoomLevel;
                
                this.camera.left = -viewSize * aspect;
                this.camera.right = viewSize * aspect;
                this.camera.top = viewSize;
                this.camera.bottom = -viewSize;
                this.camera.position.copy(this.cameraPosition);
                this.camera.updateProjectionMatrix();
                
                // Throttle region visualizations - only update when camera moves significantly
                const now = Date.now();
                if (this.regions && this.regions.length > 0 && (now - this.lastCameraUpdate > 100)) {
                    this.updateRegionVisualizations();
                    this.lastCameraUpdate = now;
                }
            }

            async connectMetaMask() {
                if (typeof window.ethereum === 'undefined') {
                    alert('MetaMask is not installed. Please install MetaMask to continue.');
                    return;
                }

                try {
                    const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                    if (accounts.length === 0) {
                        alert('No accounts found. Please unlock MetaMask.');
                        return;
                    }

                    this.currentWallet = accounts[0];
                    
                    // Check for Sandbox Avatars
                    const nftResult = await this.nftChecker.checkSandboxNFTs(this.currentWallet);
                    this.hasSandboxNFTs = nftResult.hasSandboxNFTs;
                    this.availableAvatars = nftResult.avatars || [];
                    
                    if (this.availableAvatars.length > 0) {
                        console.log(`✅ Found ${this.availableAvatars.length} Sandbox Avatar(s)!`);
                        // Show avatar selection modal
                        this.showAvatarSelection(this.availableAvatars);
                    } else {
                        console.log('No Sandbox Avatars found - will create default');
                        // Show avatar selection with option to create default
                        this.showAvatarSelection([]);
                    }
                } catch (error) {
                    console.error('MetaMask connection error:', error);
                    alert('Failed to connect MetaMask: ' + error.message);
                }
            }

            async spawnPlayer(walletID) {
                // Wait for avatar selection if not already selected
                if (!this.selectedAvatar) {
                    return; // Will be called again after avatar selection
                }

                const occupied = Array.from(this.players.keys()).map(w => {
                    const avatar = this.players.get(w);
                    // Updated for 16px tiles: 128 cols, 112 rows
                    return { id: `tile_${Math.floor((avatar.position.x + 1024) / 16)}_${Math.floor((926 - avatar.position.y) / 16)}` };
                });
                
                // Filter available tiles: must be walkable (not blocked) and have image (not blank/hidden)
                const available = this.tiles.filter(t => 
                    !occupied.some(o => o.id === t.id) &&
                    t.type !== 'blocked' &&
                    t.type !== 'hidden' // Don't spawn on hidden tiles
                );
                
                if (available.length === 0) {
                    alert('No available tiles. Maximum players reached.');
                    return;
                }

                // Randomly place on map from walkable tiles only
                const tile = available[Math.floor(Math.random() * available.length)];
                
                // Use avatar color or generate random - make it bold and bright
                let color;
                if (this.selectedAvatar.isDefault) {
                    color = this.selectedAvatar.color;
                } else {
                    // Generate bright, saturated colors that stand out
                    color = new THREE.Color().setHSL(Math.random(), 1.0, 0.5); // Full saturation
                }
                
                // Make local player color even more vibrant (bright yellow/cyan/magenta)
                const vibrantColors = [
                    new THREE.Color(0xffff00), // Bright yellow
                    new THREE.Color(0x00ffff), // Bright cyan
                    new THREE.Color(0xff00ff), // Bright magenta
                    new THREE.Color(0xff6600), // Bright orange
                    new THREE.Color(0x00ff00), // Bright green
                ];
                color = vibrantColors[Math.floor(Math.random() * vibrantColors.length)];

                const playerData = {
                    walletID: walletID,
                    x: tile.x,
                    y: tile.y,
                    color: `#${color.getHexString()}`,
                    stamina: 100,
                    inventory: [],
                    avatar: this.selectedAvatar.name || 'Default',
                    avatarImage: this.selectedAvatar.image_url || this.selectedAvatar.image || null
                };

                this.addPlayer(playerData);
                
                // Focus camera on player after a short delay (so player is visible)
                setTimeout(() => {
                    this.focusOnAvatar(tile.x, tile.y);
                }, 100);

                if (this.wsConnection && this.wsConnection.readyState === WebSocket.OPEN) {
                    this.wsConnection.send(JSON.stringify({ type: 'join', data: playerData }));
                }

                const walletDisplay = document.getElementById('wallet-id');
                walletDisplay.textContent = `${walletID.slice(0, 6)}...${walletID.slice(-4)}`;
                walletDisplay.style.color = '#4CAF50';
                
                // Show NFT status
                if (this.hasSandboxNFTs) {
                    walletDisplay.textContent += ' 🎮'; // Add icon if has Sandbox NFTs
                    walletDisplay.title = 'Has Sandbox NFTs!';
                }
                
                document.getElementById('player-count').textContent = this.players.size;
            }

            addPlayer(playerData) {
                if (this.players.has(playerData.walletID)) return;

                // Create avatar mesh - exactly 1 grid square (16px × 16px × 16px)
                const geometry = new THREE.BoxGeometry(16, 16, 16);
                const color = new THREE.Color(playerData.color);
                
                // Make player much more visible with bold colors and glow
                const isLocalPlayer = playerData.walletID === this.currentWallet;
                
                // Use brighter, more saturated colors
                const material = new THREE.MeshStandardMaterial({
                    color: color,
                    emissive: isLocalPlayer ? 0xffffff : color, // White glow for local player
                    emissiveIntensity: isLocalPlayer ? 1.0 : 0.6, // Much brighter
                    metalness: 0.3,
                    roughness: 0.2
                });

                // If avatar has image, try to use it as texture
                if (playerData.avatarImage) {
                    const loader = new THREE.TextureLoader();
                    loader.load(
                        playerData.avatarImage,
                        (texture) => {
                            material.map = texture;
                            material.needsUpdate = true;
                        },
                        undefined,
                        (error) => {
                            console.warn('Failed to load avatar image:', error);
                        }
                    );
                }

                const avatar = new THREE.Mesh(geometry, material);
                // Position at exact tile center - z position at 8 to center in grid square
                avatar.position.set(playerData.x, playerData.y, 8);
                
                // Add glow effect for local player - make it VERY visible
                if (isLocalPlayer) {
                    // Add bright yellow glow box
                    const glowGeometry = new THREE.BoxGeometry(20, 20, 20); // Larger glow
                    const glowMaterial = new THREE.MeshBasicMaterial({
                        color: 0xffff00, // Bright yellow
                        transparent: true,
                        opacity: 0.7, // More visible
                        side: THREE.BackSide
                    });
                    const glow = new THREE.Mesh(glowGeometry, glowMaterial);
                    glow.position.copy(avatar.position);
                    avatar.userData.glow = glow;
                    this.playerGroup.add(glow);
                    
                    // Add pulsing animation
                    avatar.userData.pulseSpeed = 0.03; // Faster pulse
                    avatar.userData.pulseScale = 1.0;
                    
                    // Make the avatar itself brighter
                    material.emissive.setHex(0xffffff);
                    material.emissiveIntensity = 1.5; // Very bright
                }

                // Create small label with avatar name or wallet - positioned above icon
                const displayName = playerData.avatar || `${playerData.walletID.slice(0, 6)}...${playerData.walletID.slice(-4)}`;
                
                const canvas = document.createElement('canvas');
                const context = canvas.getContext('2d');
                canvas.width = 128;
                canvas.height = 32;
                
                // Make label more visible with bold background (reuse isLocalPlayer from above)
                context.fillStyle = isLocalPlayer ? 'rgba(255, 255, 0, 0.9)' : 'rgba(0, 0, 0, 0.9)'; // Yellow for local player
                context.fillRect(0, 0, canvas.width, canvas.height);
                context.strokeStyle = isLocalPlayer ? '#000000' : '#ffffff';
                context.lineWidth = 2;
                context.strokeRect(0, 0, canvas.width, canvas.height);
                context.fillStyle = isLocalPlayer ? '#000000' : '#ffffff';
                context.font = isLocalPlayer ? 'bold 14px Arial' : '12px Arial';
                context.textAlign = 'center';
                context.fillText(displayName, canvas.width / 2, canvas.height / 2 + 4);

                const texture = new THREE.CanvasTexture(canvas);
                const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture }));
                // Position above the icon (icon is at z=8, so place label at z=25, and y offset upward)
                sprite.position.set(playerData.x, playerData.y + 12, 25);
                sprite.scale.set(40, 10, 1);

                avatar.userData.label = sprite;
                avatar.userData.avatarName = displayName;
                this.playerGroup.add(avatar);
                this.playerGroup.add(sprite);
                this.players.set(playerData.walletID, avatar);

                document.getElementById('player-count').textContent = this.players.size;
            }

            removePlayer(walletID) {
                const avatar = this.players.get(walletID);
                if (!avatar) return;
                if (avatar.userData.label) this.playerGroup.remove(avatar.userData.label);
                this.playerGroup.remove(avatar);
                this.players.delete(walletID);
                document.getElementById('player-count').textContent = this.players.size;
            }

            showAvatarSelection(avatars) {
                const modal = document.getElementById('avatar-modal');
                const container = document.getElementById('avatars-container');
                container.innerHTML = '';

                // Display found avatars
                if (avatars.length > 0) {
                    avatars.forEach((avatar, index) => {
                        const avatarCard = document.createElement('div');
                        avatarCard.style.cssText = 'border: 2px solid #444; border-radius: 8px; padding: 10px; cursor: pointer; text-align: center; transition: all 0.3s;';
                        avatarCard.onmouseover = () => avatarCard.style.borderColor = '#4CAF50';
                        avatarCard.onmouseout = () => avatarCard.style.borderColor = '#444';
                        
                        const img = document.createElement('img');
                        img.src = avatar.image_url || avatar.image || 'https://via.placeholder.com/150';
                        img.style.cssText = 'width: 100%; height: 150px; object-fit: cover; border-radius: 4px; margin-bottom: 8px;';
                        img.onerror = () => img.src = 'https://via.placeholder.com/150';
                        
                        const name = document.createElement('div');
                        name.textContent = avatar.name || `Avatar #${avatar.identifier || index + 1}`;
                        name.style.cssText = 'font-size: 12px; color: #aaa; margin-top: 5px;';
                        
                        avatarCard.appendChild(img);
                        avatarCard.appendChild(name);
                        avatarCard.onclick = () => this.selectAvatar(avatar);
                        container.appendChild(avatarCard);
                    });
                } else {
                    const noAvatars = document.createElement('div');
                    noAvatars.style.cssText = 'grid-column: 1 / -1; text-align: center; color: #888; padding: 20px;';
                    noAvatars.textContent = 'No Sandbox Avatars found in your wallet';
                    container.appendChild(noAvatars);
                }

                // Setup buttons
                document.getElementById('create-default-avatar').onclick = () => this.createDefaultAvatar();
                document.getElementById('close-avatar-modal').onclick = () => {
                    modal.style.display = 'none';
                };

                modal.style.display = 'block';
            }

            selectAvatar(avatar) {
                this.selectedAvatar = avatar;
                document.getElementById('avatar-modal').style.display = 'none';
                console.log('Selected avatar:', avatar);
                // Place icon on map, then spawn player
                this.placeAvatarIcon();
                this.spawnPlayer(this.currentWallet);
            }

            createDefaultAvatar() {
                // Create a default avatar object
                this.selectedAvatar = {
                    name: 'Default Avatar',
                    image: null,
                    isDefault: true,
                    color: new THREE.Color().setHSL(Math.random(), 0.7, 0.5)
                };
                document.getElementById('avatar-modal').style.display = 'none';
                console.log('Created default avatar');
                // Place icon on map, then spawn player
                this.placeAvatarIcon();
                this.spawnPlayer(this.currentWallet);
            }

            placeAvatarIcon() {
                // Remove existing icon if any
                if (this.avatarIcon) {
                    this.scene.remove(this.avatarIcon);
                }

                // Get random available tile (filter out blocked and hidden tiles)
                const occupied = Array.from(this.players.keys()).map(w => {
                    const avatar = this.players.get(w);
                    return { id: `tile_${Math.floor((avatar.position.x + 1024) / 16)}_${Math.floor((926 - avatar.position.y) / 16)}` };
                });
                const available = this.tiles.filter(t => 
                    !occupied.some(o => o.id === t.id) &&
                    t.type !== 'blocked' &&
                    t.type !== 'hidden'
                );
                
                if (available.length === 0) {
                    console.warn('No available tiles for icon placement');
                    return;
                }

                const tile = available[Math.floor(Math.random() * available.length)];

                // Create icon exactly 1 grid square (16px × 16px × 16px)
                // Each grid square is 16px, so icon must be exactly 16px
                const iconGeometry = new THREE.BoxGeometry(16, 16, 16);
                const iconColor = this.selectedAvatar.isDefault 
                    ? this.selectedAvatar.color 
                    : new THREE.Color().setHSL(Math.random(), 0.7, 0.5);
                
                const iconMaterial = new THREE.MeshStandardMaterial({
                    color: iconColor,
                    emissive: iconColor,
                    emissiveIntensity: 0.5
                });

                this.avatarIcon = new THREE.Mesh(iconGeometry, iconMaterial);
                // Position at exact tile center (tile.x, tile.y are already the center coordinates)
                this.avatarIcon.position.set(tile.x, tile.y, 8);
                
                // No pulsing - keep it exactly 1 square size
                this.avatarIcon.userData.originalScale = 1.0;
                this.avatarIcon.userData.pulseSpeed = 0;

                // No label needed for icon - just the cube itself
                this.scene.add(this.avatarIcon);

                console.log(`Avatar icon placed at tile: ${tile.id} (${tile.x}, ${tile.y})`);
            }

            focusOnAvatar(x, y) {
                // Target position
                const targetX = x;
                const targetY = y;
                const targetZoom = 3.0; // Zoom in closer
                
                // Start position
                const startX = this.cameraPosition.x;
                const startY = this.cameraPosition.y;
                const startZoom = this.zoomLevel;
                
                // Animation duration (milliseconds)
                const duration = 1500;
                const startTime = Date.now();
                
                // Easing function (ease out)
                const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
                
                const animate = () => {
                    const elapsed = Date.now() - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = easeOutCubic(progress);
                    
                    // Interpolate position
                    this.cameraPosition.x = startX + (targetX - startX) * eased;
                    this.cameraPosition.y = startY + (targetY - startY) * eased;
                    
                    // Interpolate zoom
                    this.zoomLevel = startZoom + (targetZoom - startZoom) * eased;
                    
                    // Update camera
                    this.updateCamera();
                    
                    // Continue animation if not complete
                    if (progress < 1) {
                        requestAnimationFrame(animate);
                    } else {
                        console.log('Camera focused on avatar');
                    }
                };
                
                animate();
            }

            toggleGrid() {
                this.isGridVisible = !this.isGridVisible;
                this.gridGroup.visible = this.isGridVisible;
            }

            animate() {
                requestAnimationFrame(() => this.animate());
                
                const now = Date.now();
                
                // Smooth zoom interpolation with easing
                if (Math.abs(this.zoomLevel - this.targetZoomLevel) > 0.001) {
                    const zoomDiff = this.targetZoomLevel - this.zoomLevel;
                    // Use exponential easing for smoother feel
                    this.zoomLevel += zoomDiff * 0.12; // Slower interpolation for smoother feel
                    this.cameraNeedsUpdate = true;
                }
                
                // Update camera only when needed (zoom changed or position changed)
                if (this.cameraNeedsUpdate) {
                    this.updateCamera();
                    this.clampCameraToBounds();
                    this.cameraNeedsUpdate = false;
                }
                
                // Throttle expensive updates - road degradation every 5 seconds
                if (now - this.lastRoadUpdate >= this.roadUpdateInterval) {
                this.updateRoadDegradation();
                    this.lastRoadUpdate = now;
                }
                
                // Throttle crafting UI updates - only every 500ms, not every frame
                if (this.currentCraftingStation && document.getElementById('crafting-modal')?.style.display === 'block') {
                    if (now - this.lastCraftingUIUpdate >= this.craftingUIUpdateInterval) {
                        this.updateCraftingUI();
                        this.lastCraftingUIUpdate = now;
                    }
                }
                
                // Process pending route updates (throttled to prevent lag)
                if (this.isPlottingRoute && this.pendingRouteUpdate) {
                    if (now - this.lastRouteUpdate >= this.routeUpdateInterval) {
                        this.processRouteUpdate(this.pendingRouteUpdate);
                        this.pendingRouteUpdate = null;
                        this.lastRouteUpdate = now;
                    }
                }
                
                // Keep icon at exactly 1 grid square size (no animation)
                if (this.avatarIcon) {
                    // Ensure it stays at exactly 1.0 scale (1 grid square = 16px)
                    this.avatarIcon.scale.set(1.0, 1.0, 1.0);
                }
                
                // Animate player glow/pulse for local player
                const localPlayer = this.players.get(this.currentWallet);
                if (localPlayer && localPlayer.userData.glow) {
                    // Pulse effect
                    if (localPlayer.userData.pulseSpeed) {
                        localPlayer.userData.pulseScale += localPlayer.userData.pulseSpeed;
                        if (localPlayer.userData.pulseScale > 1.3 || localPlayer.userData.pulseScale < 1.0) {
                            localPlayer.userData.pulseSpeed *= -1;
                        }
                        localPlayer.userData.glow.scale.set(
                            localPlayer.userData.pulseScale,
                            localPlayer.userData.pulseScale,
                            localPlayer.userData.pulseScale
                        );
                        localPlayer.userData.glow.material.opacity = 0.4 + (localPlayer.userData.pulseScale - 1.0) * 0.5;
                    }
                }
                
                // Update movement
                this.updateMovement();
                
                // Render (only if we didn't return early above)
                this.renderer.render(this.scene, this.camera);
            }

            clampCameraToBounds() {
                const aspect = window.innerWidth / window.innerHeight;
                const viewSize = 2000 / this.zoomLevel;
                const halfViewWidth = viewSize * aspect;
                const halfViewHeight = viewSize;
                
                const halfMapWidth = 1024; // mapWidth / 2
                const halfMapHeight = 926; // mapHeight / 2
                
                // Clamp camera position
                this.cameraPosition.x = Math.max(
                    -halfMapWidth + halfViewWidth,
                    Math.min(halfMapWidth - halfViewWidth, this.cameraPosition.x)
                );
                this.cameraPosition.y = Math.max(
                    -halfMapHeight + halfViewHeight,
                    Math.min(halfMapHeight - halfViewHeight, this.cameraPosition.y)
                );
                
                this.cameraNeedsUpdate = true; // Mark camera as needing update
            }
        }

        // Start game
        window.game = new Game();
    </script>
