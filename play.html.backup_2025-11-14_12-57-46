                    const remaining = Math.max(0, extraction.duration - elapsed);
                    const progress = Math.min(100, (elapsed / extraction.duration) * 100);
                    
                    return `
                        <div style="margin-bottom: 8px; padding: 8px; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ff00;">
                            <div style="font-size: 11px; color: #00ff00; margin-bottom: 4px;">${extraction.resourceName}</div>
