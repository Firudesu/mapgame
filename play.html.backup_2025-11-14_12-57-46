            /**
             * Generate a random work order for a megacorp
             */
            generateRandomWorkOrder(megacorp) {
                const recipes = this.getRecipeDatabase();
                const allRecipes = [
                    ...recipes.resourceOnly,
                    ...recipes.resourceToItem,
                    ...recipes.itemToRare,
                    ...recipes.rareToLegendary
                ];
                
                // Filter recipes by megacorp preference (or random if no preference)
                const megacorpRecipes = allRecipes.filter(r => 
                    r.megacorp === megacorp.corp || Math.random() < 0.3 // 30% chance for cross-corp orders
                );
                
                // Select random recipe
                const recipe = megacorpRecipes.length > 0 
                    ? megacorpRecipes[Math.floor(Math.random() * megacorpRecipes.length)]
                    : allRecipes[Math.floor(Math.random() * allRecipes.length)];
                
                // Generate quota and payout based on item rarity
                let quota, payout;
                if (recipe.category === 'resource') {
                    // Resource-only orders: large quotas, lower payout
                    quota = 1000 + Math.floor(Math.random() * 2000); // 1000-3000
                    payout = 5 + Math.floor(Math.random() * 10); // 5-15 SAND per resource
                } else if (recipe.category === 'legendary') {
                    quota = 50 + Math.floor(Math.random() * 100); // 50-150
                    payout = 100 + Math.floor(Math.random() * 50); // 100-150 SAND
                } else if (recipe.category === 'rare') {
                    quota = 200 + Math.floor(Math.random() * 300); // 200-500
                    payout = 40 + Math.floor(Math.random() * 30); // 40-70 SAND
                } else {
                    quota = 500 + Math.floor(Math.random() * 500); // 500-1000
                    payout = 15 + Math.floor(Math.random() * 20); // 15-35 SAND
                }
                
                return {
                    item: recipe.name,
                    recipe: {
                        ingredients: recipe.ingredients,
                        output: recipe.output,
                        time: recipe.time,
                        category: recipe.category
                    },
                    quota: quota,
                    payout: payout
                };
            }
            
