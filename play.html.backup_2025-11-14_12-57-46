                });
            }

            getTileAtMousePosition(event) {
                const rect = this.renderer.domElement.getBoundingClientRect();
                this.mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
                this.mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
                
                this.raycaster.setFromCamera(this.mouse, this.camera);
                
                // First, check if we're hitting any building/megacorp meshes
                const buildingMeshes = [];
                this.multiTileAssets.forEach(asset => {
                    if (asset.mesh) {
                        buildingMeshes.push(asset.mesh);
                    }
                });
                
                if (buildingMeshes.length > 0) {
                    const intersects = this.raycaster.intersectObjects(buildingMeshes, false);
                    if (intersects.length > 0) {
                        // Found a building mesh - find which asset it belongs to
                        const hitMesh = intersects[0].object;
                        const asset = this.multiTileAssets.find(a => a.mesh === hitMesh);
                        if (asset) {
                            // Get the tile at the intersection point
                            const intersectPoint = intersects[0].point;
                            const tile = this.getTileAtPosition(intersectPoint.x, intersectPoint.y);
                            if (tile) {
                                // Ensure tile has assetId set so hover detection works
                                tile.assetId = asset.id;
                                tile.assetType = asset.type;
                                tile.assetName = asset.name;
                            }
                            return tile || this.getTileAtPosition(intersectPoint.x, intersectPoint.y);
                        }
                    }
                }
                
                // Fallback: use plane intersection for tiles
                const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
                const intersectPoint = new THREE.Vector3();
                this.raycaster.ray.intersectPlane(plane, intersectPoint);
                
                const tile = this.getTileAtPosition(intersectPoint.x, intersectPoint.y);
                
                // If tile doesn't have assetId but we know it should (from multi-tile asset), set it
                if (tile && !tile.assetId) {
                    for (const asset of this.multiTileAssets) {
                        if (tile.col >= asset.startCol && 
                            tile.col < asset.startCol + asset.width &&
                            tile.row >= asset.startRow && 
                            tile.row < asset.startRow + asset.height) {
                            tile.assetId = asset.id;
                            tile.assetType = asset.type;
                            tile.assetName = asset.name;
                            break;
                        }
                    }
                }
                
                return tile;
            }
            
            /**
             * Check if player is on or adjacent to a tile (within 1 tile distance)
             * For multi-tile buildings, checks if player is adjacent to ANY tile of the building
             */
            isPlayerNearTile(tile) {
                if (!this.currentWallet) {
                    console.log('⚠️ isPlayerNearTile: No wallet');
                    return false;
                }
                
                const player = this.players.get(this.currentWallet);
                if (!player) {
                    console.log('⚠️ isPlayerNearTile: No player');
                    return false;
                }
                
                // Convert player world position to tile coordinates
                const playerCol = Math.floor((player.position.x + 1024) / 16);
                const playerRow = Math.floor((926 - player.position.y) / 16);
                
                // If tile is part of a multi-tile asset, check all tiles of that asset
                if (tile.assetId) {
                    const asset = this.multiTileAssets.find(a => a.id === tile.assetId);
                    if (asset) {
                        // Check if player is ON any tile of the building (colDiff === 0 && rowDiff === 0)
                        // OR adjacent to any tile (colDiff <= 1 && rowDiff <= 1)
                        for (let c = asset.startCol; c < asset.startCol + asset.width; c++) {
                            for (let r = asset.startRow; r < asset.startRow + asset.height; r++) {
                                const colDiff = Math.abs(playerCol - c);
                                const rowDiff = Math.abs(playerRow - r);
                                
                                // If player is ON or adjacent to any tile of the building, they can interact
                                if (colDiff <= 1 && rowDiff <= 1) {
                                    console.log(`✅ Player near building: player(${playerCol}, ${playerRow}) ${colDiff === 0 && rowDiff === 0 ? 'ON' : 'adjacent to'} building tile(${c}, ${r})`);
                                    return true;
                                }
                            }
                        }
                        console.log(`❌ Player not near building: player(${playerCol}, ${playerRow}), building(${asset.startCol}-${asset.startCol + asset.width}, ${asset.startRow}-${asset.startRow + asset.height})`);
                        return false;
                    }
                }
                
                // For single tiles (resources, etc.), check the specific tile
                const targetCol = tile.col;
                const targetRow = tile.row;
                
                const colDiff = Math.abs(playerCol - targetCol);
                const rowDiff = Math.abs(playerRow - targetRow);
                
                // Adjacent means: same tile OR distance of 1 in any direction (including diagonals)
                const isNear = colDiff <= 1 && rowDiff <= 1;
                if (!isNear) {
                    console.log(`❌ Player not near tile: player(${playerCol}, ${playerRow}), tile(${targetCol}, ${targetRow}), diff(${colDiff}, ${rowDiff})`);
                }
                return isNear;
            }
            
