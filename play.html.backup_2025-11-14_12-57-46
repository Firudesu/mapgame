            async init() {
                try {
                    const container = document.getElementById('canvas-container');
                    if (!container) {
                        console.error('❌ Canvas container not found!');
                        return;
                    }
                    
                    this.renderer.setSize(window.innerWidth, window.innerHeight);
                    this.renderer.setClearColor(0x1a1a1a);
                    container.appendChild(this.renderer.domElement);

                    // Center camera on map (map is 2048x1852, center at 0,0)
                    this.cameraPosition.set(0, 0, 1000);
                    this.camera.position.copy(this.cameraPosition);
                    this.camera.lookAt(0, 0, 0);
                    this.updateCamera();

                    // Load map (this will analyze image areas)
                    try {
                        await this.loadMap();
                    } catch (error) {
                        console.error('❌ Failed to load map:', error);
                        alert('Failed to load map image. Please check that mapsize.png exists in the project folder.');
                        return;
                    }
                    
                    // Create 8x8 smaller grid: 16*8 = 128 cols, 14*8 = 112 rows, 128/8 = 16px tiles
                    // Grid creation now checks for image content and blocks areas without image
                    this.createGrid(128, 112, 16);

                    // Initialize multi-tile assets array
                    this.multiTileAssets = [];
                    
                    this.scene.add(this.playerGroup);
                    this.setupEventListeners();
                    this.setupWebSocket();
                    this.setupTileInteraction();
                    this.updateCameraBounds(); // Update camera with bounds
                    this.updateEconomyDisplay(); // Initialize economy display
                    this.updateDailyRewardUI(); // Initialize daily reward UI
                    
                    // Start update loops
                    setInterval(() => {
                        this.updateDailyRewardUI();
                        this.checkFragileItems();
                        if (this.inventoryModalOpen) {
                            this.renderInventoryUI(); // Update fragile item timers
                        }
                    }, 1000); // Update every second
                    
                    this.animate();
                    
                    console.log('✅ Game initialized successfully!');
                } catch (error) {
                    console.error('❌ Error initializing game:', error);
                    alert('Error initializing game: ' + error.message);
                }
            }

            updateCameraBounds() {
                // Allow much higher zoom (0.1x - 20.0x)
                this.minZoom = 0.1;
                this.maxZoom = 20.0;
                if (this.zoomLevel < this.minZoom) this.zoomLevel = this.minZoom;
                if (this.zoomLevel > this.maxZoom) this.zoomLevel = this.maxZoom;
                if (this.targetZoomLevel < this.minZoom) this.targetZoomLevel = this.minZoom;
                if (this.targetZoomLevel > this.maxZoom) this.targetZoomLevel = this.maxZoom;
                this.cameraNeedsUpdate = true;
            }

            async loadMap() {
                return new Promise((resolve, reject) => {
                    const loader = new THREE.TextureLoader();
                    // Try multiple possible paths for the map
                    const mapPaths = [
                        './public/mapsize.png',
                        '/public/mapsize.png',
                        './mapsize.png',
                        'mapsize.png',
                        '/mapsize.png'
                    ];
                    
                    let currentPathIndex = 0;
                    const tryLoad = (pathIndex) => {
                        if (pathIndex >= mapPaths.length) {
                            console.error('❌ Could not load map from any path');
                            reject(new Error('Map not found'));
                            return;
                        }
                        
                        loader.load(
                            mapPaths[pathIndex],
                            (texture) => {
                                console.log(`✅ Map loaded from: ${mapPaths[pathIndex]}`);
                                const geometry = new THREE.PlaneGeometry(2048, 1852);
                                const material = new THREE.MeshBasicMaterial({ map: texture });
                                const mesh = new THREE.Mesh(geometry, material);
                                mesh.position.set(0, 0, 0);
                                this.scene.add(mesh);
                                
                                // Store texture for image detection
                                this.mapTexture = texture;
                                
                                // Analyze image to find valid areas
                                this.analyzeImageAreas(texture).then(() => {
                                    resolve();
                                });
                            },
                            undefined,
                            (error) => {
                                console.warn(`Failed to load from ${mapPaths[pathIndex]}, trying next...`);
                                tryLoad(pathIndex + 1);
                            }
                        );
                    };
                    
                    tryLoad(0);
                });
            }

            async analyzeImageAreas(texture) {
                // Create a canvas to read image data
                const img = texture.image;
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);
                
                // Store image data for tile checking
                this.imageData = ctx.getImageData(0, 0, img.width, img.height);
                this.imageWidth = img.width;
                this.imageHeight = img.height;
                
                console.log(`✅ Map image loaded: ${img.width}x${img.height}`);
            }

            hasImageAtPosition(x, y) {
                if (!this.imageData) return true; // Default to true if not loaded yet
                
                // Convert world coordinates to image pixel coordinates
                const halfWidth = 1024;
                const halfHeight = 926;
                const pixelX = Math.floor((x + halfWidth) * (this.imageWidth / 2048));
                const pixelY = Math.floor((halfHeight - y) * (this.imageHeight / 1852));
                
                // Check bounds
                if (pixelX < 0 || pixelX >= this.imageWidth || pixelY < 0 || pixelY >= this.imageHeight) {
                    return false; // Outside image bounds
                }
                
                // Get pixel data (RGBA)
                const index = (pixelY * this.imageWidth + pixelX) * 4;
                const r = this.imageData.data[index];
                const g = this.imageData.data[index + 1];
                const b = this.imageData.data[index + 2];
                const a = this.imageData.data[index + 3];
                
                // Check if pixel is transparent or pure black (no image content)
                const isTransparent = a < 10; // Almost transparent
                const isBlack = r < 10 && g < 10 && b < 10 && a > 200; // Pure black with opacity
                
                return !isTransparent && !isBlack; // Has image content
            }

            createGrid(cols, rows, tileSize) {
                const halfWidth = 1024;
                const halfHeight = 926;
                const gridMaterial = new THREE.LineBasicMaterial({
                    color: 0x00ff00,
                    opacity: 0.3,
                    transparent: true
                });

                // Vertical lines
                for (let i = 0; i <= cols; i++) {
                    const x = -halfWidth + (i * tileSize);
                    const geometry = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(x, -halfHeight, 1),
                        new THREE.Vector3(x, halfHeight, 1)
                    ]);
                    const line = new THREE.Line(geometry, gridMaterial);
                    this.gridGroup.add(line);
                }

                // Horizontal lines
                for (let i = 0; i <= rows; i++) {
                    const y = halfHeight - (i * tileSize);
                    const geometry = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(-halfWidth, y, 1),
                        new THREE.Vector3(halfWidth, y, 1)
                    ]);
                    const line = new THREE.Line(geometry, gridMaterial);
                    this.gridGroup.add(line);
                }

                // Create tiles with random types
                for (let row = 0; row < rows; row++) {
                    for (let col = 0; col < cols; col++) {
                        const tileX = -halfWidth + (col * tileSize) + (tileSize / 2);
                        const tileY = halfHeight - (row * tileSize) - (tileSize / 2);
                        
                        // Check if this tile has image content
                        const hasImage = this.hasImageAtPosition(tileX, tileY);
                        
                        // If no image, mark as blocked
                        if (!hasImage) {
                            this.tiles.push({
                                id: `tile_${col}_${row}`,
                                col: col,
                                row: row,
                                x: tileX,
                                y: tileY,
                                type: 'blocked',
                                subType: 'no-image',
                                active: false
                            });
                            continue; // Skip to next tile
                        }
                        
                        // Assign tile types with more variety (only for tiles with image)
                        // NOTE: Roads are NOT randomly placed - they are created by connectBuildingsWithRoads()
                        const rand = Math.random();
                        let tileType = 'blank';
                        let tileSubType = null;
                        
                        if (rand < 0.08) {
                            tileType = 'hazard';
                            const hazardTypes = ['snow', 'desert', 'river', 'tech'];
                            tileSubType = hazardTypes[Math.floor(Math.random() * hazardTypes.length)];
                        } else if (rand < 0.10) {
                            tileType = 'resource';
                        } else if (rand < 0.11) {
                            tileType = 'city';
                        } else if (rand < 0.12) {
                            tileType = 'hospital';
                        } else if (rand < 0.13) {
                            tileType = 'campsite';
                        } else if (rand < 0.14) {
                            tileType = 'market';
                        } else if (rand < 0.15) {
                            tileType = 'bridge';
                        } else if (rand < 0.16) {
                            tileType = 'crafting';
                        } else if (rand < 0.17) {
                            tileType = 'storage';
                        } else if (rand < 0.18) {
                            tileType = 'gdp';
                        } else if (rand < 0.19) {
                            tileType = 'rare_resource';
                        } else if (rand < 0.20) {
                            tileType = 'hidden';
                        } else if (rand < 0.25) {
                            tileType = 'blocked';
                        }
                        
                        this.tiles.push({
                            id: `tile_${col}_${row}`,
                            col: col,
                            row: row,
                            x: tileX,
                            y: tileY,
                            type: tileType,
                            subType: tileSubType,
