                if (modal) {
                    modal.style.display = 'none';
                }
            }
            
            /**
             * Open Crafting Station Modal
             */
            openCraftingStation(stationId) {
                // Hide tooltip when opening modal
                const tooltip = document.getElementById('hover-tooltip');
                if (tooltip) {
                    tooltip.style.display = 'none';
                }
                
                this.currentCraftingStation = stationId;
                
                // Initialize queue if doesn't exist
                if (!this.craftingQueues.has(stationId)) {
                    this.craftingQueues.set(stationId, []);
                }
                
                const modal = document.getElementById('crafting-modal');
                if (modal) {
                    this.updateCraftingUI();
                    modal.style.display = 'block';
                    
                    // Start periodic UI updates for crafting progress (only update queues, not recipes)
                    if (this.craftingUIUpdateInterval) {
                        clearInterval(this.craftingUIUpdateInterval);
                    }
                    this.craftingUIUpdateInterval = setInterval(() => {
                        if (this.currentCraftingStation && modal.style.display === 'block') {
                            // Only update the queues section, not the recipes (to preserve event listeners)
                            this.updateCraftingQueuesOnly();
                        } else {
                            clearInterval(this.craftingUIUpdateInterval);
                            this.craftingUIUpdateInterval = null;
                        }
                    }, 500); // Update every 500ms for smooth progress bars
                }
            }
            
            /**
             * Close Crafting Station Modal
             */
            closeCraftingStation() {
                const modal = document.getElementById('crafting-modal');
                if (modal) {
                    modal.style.display = 'none';
                }
                
                // Stop UI update interval
                if (this.craftingUIUpdateInterval) {
                    clearInterval(this.craftingUIUpdateInterval);
                    this.craftingUIUpdateInterval = null;
                }
                
                this.currentCraftingStation = null;
            }
            
            /**
             * Update Crafting UI
             */
            updateCraftingUI() {
                if (!this.currentCraftingStation) return;
                
                const queuesContainer = document.getElementById('crafting-queues-container');
                const recipesContainer = document.getElementById('available-recipes-container');
                
                if (!queuesContainer || !recipesContainer) return;
                
                // Use the same update function for queues (with event delegation)
                this.updateCraftingQueuesOnly();
                
                // Display available recipes (only if not already initialized)
                if (!recipesContainer._recipesInitialized) {
                this.updateAvailableRecipes(recipesContainer);
                }
            }
            
            /**
             * Create crafting queue card
             */
            createCraftingQueueCard(queue, index) {
                const card = document.createElement('div');
                card.style.cssText = 'margin-bottom: 15px; padding: 12px; border: 3px solid #00ff00; background: rgba(0, 0, 0, 0.5); font-family: "Press Start 2P", monospace;';
                
                const recipe = queue.recipe;
                const completed = queue.completed || 0;
                const total = queue.quantity;
                const progress = total > 0 ? (completed / total) * 100 : 0;
                const remaining = total - completed;
                
                // Get timer info
                const timer = this.craftingTimers.get(queue.id);
                let statusText = '';
                let timeRemaining = '';
                
                if (timer) {
                    if (timer.isActive) {
                        const elapsed = Date.now() - timer.startTime;
                        const baseTime = timer.baseTime * 1000; // Convert to ms
                        const speedMultiplier = 1 - (timer.speedUpPercent / 100); // 85% speed = 0.15 multiplier
                        const adjustedTime = baseTime * speedMultiplier;
                        const remainingMs = Math.max(0, adjustedTime - elapsed);
                        const remainingSec = Math.ceil(remainingMs / 1000);
                        timeRemaining = `TIME: ${remainingSec}s`;
                        statusText = '▶ CRAFTING...';
                    } else if (completed < total) {
                        statusText = '▶ QUEUED';
                    }
                }
                
                if (completed >= total) {
                    statusText = '▶ COMPLETE';
                }
                
                // Progress bar
                const barWidth = 25;
                const filled = Math.floor((progress / 100) * barWidth);
                const empty = barWidth - filled;
                const progressBar = '█'.repeat(filled) + '░'.repeat(empty);
                
                card.innerHTML = `
                    <div style="margin-bottom: 10px;">
                        <div style="font-size: 9px; color: #00ff00; margin-bottom: 5px; text-shadow: 2px 2px 0px #000;">
                            ▶ QUEUE #${index + 1}: ${recipe.name}
                        </div>
                        <div style="font-size: 11px; color: ${completed >= total ? '#ffff00' : '#aaa'}; text-shadow: 1px 1px 0px #000;">
                            ${statusText}
                        </div>
                        ${timeRemaining ? `<div style="font-size: 11px; color: #aaa; margin-top: 3px;">${timeRemaining}</div>` : ''}
                    </div>
                    <div style="margin-bottom: 10px; font-size: 11px; color: #00ff00;">
                        <div style="margin-bottom: 5px; text-shadow: 1px 1px 0px #000;">PROGRESS: ${completed} / ${total} (${Math.round(progress)}%)</div>
                        <div style="color: #00ff00; font-family: monospace; letter-spacing: 2px; margin: 5px 0; font-size: 9px;">
                            ${progressBar}
                        </div>
                    </div>
                    <div style="font-size: 11px; color: #aaa; margin-bottom: 10px; border-top: 2px solid #00ff00; padding-top: 8px;">
                        <div style="color: #00ff00; margin-bottom: 5px; text-shadow: 1px 1px 0px #000;">▶ INGREDIENTS:</div>
                        <div style="margin-left: 10px; margin-top: 3px; line-height: 1.8;">
                            ${recipe.ingredients.map(ing => `• ${ing.quantity}x ${ing.name}`).join('<br/>')}
                        </div>
                    </div>
                    ${completed >= total ? `
                        <button class="withdraw-craft-btn" data-queue-id="${queue.id}" style="padding: 8px 16px; background: #000; color: #00ff00; border: 2px solid #00ff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(0, 255, 0, 0.5); transition: all 0.2s; margin-top: 5px; pointer-events: auto; z-index: 100; position: relative;">WITHDRAW</button>
                    ` : `
                        <div style="display: flex; gap: 8px; margin-top: 8px;">
                            ${timer && timer.isActive && timer.speedUpPercent < 100 ? `
                                <button class="speed-up-craft-btn" data-queue-id="${queue.id}" style="padding: 8px 16px; background: #000; color: #ffff00; border: 2px solid #ffff00; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 255, 0, 0.5); transition: all 0.2s; pointer-events: auto; z-index: 100; position: relative;">SPEED UP</button>
                            ` : ''}
                            <button class="cancel-craft-btn" data-queue-id="${queue.id}" style="padding: 8px 16px; background: #000; color: #ff0000; border: 2px solid #ff0000; cursor: pointer; font-size: 11px; font-family: 'Press Start 2P', monospace; text-transform: uppercase; box-shadow: 0 0 5px rgba(255, 0, 0, 0.5); transition: all 0.2s; pointer-events: auto; z-index: 100; position: relative;">CANCEL</button>
                        </div>
